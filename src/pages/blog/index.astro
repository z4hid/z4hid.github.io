---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SiteAnalytics from '../../components/SiteAnalytics.astro';
import NonBlockingFontAwesome from '../../components/NonBlockingFontAwesome.astro';
import InteractiveBackground from '../../components/InteractiveBackground.astro';
import { getCollection } from 'astro:content';

const description = 'Practical engineering guides on Large Language Models, agentic AI workflows, RAG systems, and production AI architectures by Md. Zahid Hasan.';

const base = import.meta.env.BASE_URL;

let posts: any[] = [];
try {
  const allPosts = await getCollection('blog');
  posts = allPosts
    .filter((p: any) => !p.data.draft)
    .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
} catch (e) {
  // No blog posts yet
}

// Function to estimate word count and format date
function getPostMeta(post: any) {
  const bodyText = post.body || '';
  const wordCount = bodyText.trim().split(/\s+/).filter(Boolean).length || 1200;
  const formattedWords = wordCount >= 1000 ? `~${(wordCount / 1000).toFixed(1)}K words` : `~${wordCount} words`;
  return {
    words: formattedWords,
    dateStr: post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase(),
  };
}

// Tag color assignment helper
function getTagColorClass(tag: string): string {
  const t = tag.toLowerCase();
  if (t.includes('agent') || t.includes('autonomous')) return 'badge-cyan';
  if (t.includes('rag') || t.includes('vector') || t.includes('retrieval')) return 'badge-purple';
  if (t.includes('vision') || t.includes('cv') || t.includes('image')) return 'badge-pink';
  if (t.includes('python') || t.includes('data') || t.includes('ml')) return 'badge-blue';
  if (t.includes('security') || t.includes('laravel')) return 'badge-red';
  if (t.includes('career') || t.includes('work') || t.includes('mindset')) return 'badge-yellow';
  return 'badge-green';
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <title>Blog | Md. Zahid Hasan — AI & Security</title>
  <meta name="description" content={description} />
  <meta name="author" content="Md. Zahid Hasan" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:title" content="Blog — Md. Zahid Hasan" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@z4hiid" />
  <meta name="twitter:title" content="Blog — Md. Zahid Hasan" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <NonBlockingFontAwesome />
  <link rel="alternate" type="application/rss+xml" title="Md. Zahid Hasan Blog RSS" href={`${base}rss.xml`} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(base, Astro.site).href },
          { "@type": "ListItem", "position": 2, "name": "Blog", "item": new URL(`${base}blog`, Astro.site).href }
        ]
      },
      {
        "@type": "Blog",
        "name": "Md. Zahid Hasan — AI Engineering Blog",
        "description": description,
        "url": new URL(`${base}blog`, Astro.site).href,
        "author": { "@type": "Person", "name": "Md. Zahid Hasan", "url": new URL(base, Astro.site).href }
      }
    ]
  })} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <InteractiveBackground />
  <Header />

  <main id="main-content" class="blog-page">
    <div class="container container--narrow">

      <h1 class="sr-only">AI & Engineering Blog</h1>

      <!-- Top Search & RSS Bar matching Screenshot 3 -->
      <div class="blog-search-bar">
        <div class="search-input-wrapper">
          <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="blog-search-input"
            class="blog-search-input"
            placeholder="Type to filter posts..."
            autocomplete="off"
            aria-label="Filter blog posts"
          />
          <button id="search-clear-btn" class="search-clear-btn" aria-label="Clear blog search" style="display: none;">
            ✕
          </button>
        </div>

        <a href={`${base}rss.xml`} class="btn btn--neutral rss-btn" target="_blank" rel="noopener" aria-label="Subscribe via RSS">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          <span>RSS</span>
        </a>
      </div>

      <!-- Blog Posts Feed matching Screenshot 3 -->
      <div class="blog-feed" id="blog-feed">
        {posts.map((post: any, idx: number) => {
          const slug = post.id.replace(/\.md$/, '');
          const meta = getPostMeta(post);
          const tags = post.data.tags || [];
          const primaryTag = tags[0] || 'AI Engineering';
          const isLatest = idx === 0;

          return (
            <article
              class="blog-article-item"
              data-title={post.data.title.toLowerCase()}
              data-desc={(post.data.description || '').toLowerCase()}
              data-tags={tags.join(' ').toLowerCase()}
            >
              <!-- Date & Latest Badge -->
              <div class="blog-article__top">
                <span class="blog-article__date">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <time datetime={post.data.pubDate.toISOString()}>{meta.dateStr}</time>
                </span>
                {isLatest && <span class="badge-latest">Latest Post</span>}
              </div>

              <!-- Title -->
              <h2 class="blog-article__title">
                <a href={`${base}blog/${slug}`}>{post.data.title}</a>
              </h2>

              <!-- Excerpt Description -->
              <p class="blog-article__desc">{post.data.description}</p>

              <!-- Footer Meta & Badges -->
              <div class="blog-article__meta">
                <span class="blog-article__words">{meta.words}</span>
                <span class="meta-dot">·</span>
                {tags.slice(0, 3).map((tag: string) => (
                  <span class:list={['category-badge', getTagColorClass(tag)]}>{tag}</span>
                ))}
              </div>
            </article>
          );
        })}
      </div>

      <!-- Empty Search State -->
      <div id="blog-search-empty" class="blog-search-empty" style="display: none;">
        <p>No posts matching <strong id="empty-query-text"></strong></p>
        <button id="reset-search-btn" class="btn btn--neutral" style="margin-top: var(--space-3);">Clear Filter</button>
      </div>

    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  .blog-page {
    padding-top: calc(60px + var(--space-7));
    padding-bottom: var(--space-8);
  }

  /* Search & RSS bar */
  .blog-search-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .search-input-wrapper {
    position: relative;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }

  .search-input-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-pill);
    pointer-events: none;
  }

  .search-icon {
    position: absolute;
    left: var(--space-4);
    color: var(--text-faint);
    pointer-events: none;
  }

  .blog-search-input {
    width: 100%;
    background: var(--bg-card);
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.625rem 2.5rem 0.625rem 2.625rem;
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    color: var(--text-strong);
    outline: none;
    transition: background-color var(--duration) var(--ease-out);
  }

  .blog-search-input:focus {
    background: var(--bg-card-hover);
  }

  .blog-search-input::placeholder {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }

  .search-clear-btn {
    position: absolute;
    right: var(--space-4);
    background: none;
    border: none;
    color: var(--text-faint);
    font-size: var(--fs-xs);
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
  }
  .search-clear-btn:hover { color: var(--text-strong); }

  .rss-btn {
    flex-shrink: 0;
    min-height: 2.375rem;
    padding-inline: var(--space-4);
    gap: 6px;
  }

  /* Articles Feed matching Screenshot 3 */
  .blog-feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .blog-article-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-muted);
    transition: opacity var(--duration) var(--ease-out);
  }

  .blog-article-item:last-child {
    border-bottom: none;
  }

  .blog-article-item.hidden {
    display: none;
  }

  .blog-article__top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .blog-article__date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.05em;
  }

  .badge-latest {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.1);
    color: var(--text-strong);
    border: 1px solid var(--ink-faint);
  }

  .blog-article__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 1.95rem);
    font-weight: 520;
    line-height: 1.22;
    margin: 2px 0;
  }

  .blog-article__title a {
    color: var(--text-strong);
    text-decoration: none;
    transition: color var(--duration) var(--ease-out);
  }

  .blog-article__title a:hover {
    color: var(--accent);
  }

  .blog-article__desc {
    font-size: var(--fs-md);
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
    max-width: 68ch;
  }

  .blog-article__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    flex-wrap: wrap;
  }

  .blog-article__words {
    color: var(--text-faint);
  }

  .meta-dot {
    color: var(--ink);
  }

  /* Color-coded category badges matching Screenshot 3 */
  .category-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 4px;
    display: inline-block;
  }

  .badge-green {
    background: oklch(0.24 0.05 155 / 0.35);
    color: #34d399;
    border: 1px solid oklch(0.45 0.1 155 / 0.3);
  }

  .badge-cyan {
    background: oklch(0.24 0.05 210 / 0.35);
    color: #38bdf8;
    border: 1px solid oklch(0.45 0.1 210 / 0.3);
  }

  .badge-purple {
    background: oklch(0.24 0.05 300 / 0.35);
    color: #c084fc;
    border: 1px solid oklch(0.45 0.1 300 / 0.3);
  }

  .badge-pink {
    background: oklch(0.24 0.05 350 / 0.35);
    color: #f472b6;
    border: 1px solid oklch(0.45 0.1 350 / 0.3);
  }

  .badge-blue {
    background: oklch(0.24 0.05 250 / 0.35);
    color: #60a5fa;
    border: 1px solid oklch(0.45 0.1 250 / 0.3);
  }

  .badge-red {
    background: oklch(0.24 0.05 25 / 0.35);
    color: #f87171;
    border: 1px solid oklch(0.45 0.1 25 / 0.3);
  }

  html.light-mode .badge-green { color: #065f46; background: #d1fae5; border-color: #a7f3d0; }
  html.light-mode .badge-cyan { color: #075985; background: #e0f2fe; border-color: #bae6fd; }
  html.light-mode .badge-purple { color: #6b21a8; background: #f3e8ff; border-color: #e9d5ff; }
  html.light-mode .badge-pink { color: #9d174d; background: #fce7f3; border-color: #fbcfe8; }
  html.light-mode .badge-blue { color: #1e3a8a; background: #dbeafe; border-color: #bfdbfe; }
  html.light-mode .badge-red { color: #991b1b; background: #fee2e2; border-color: #fecaca; }
  html.light-mode .badge-yellow { color: #92400e; background: #fef3c7; border-color: #fde68a; }

  .badge-yellow {
    background: oklch(0.24 0.05 85 / 0.35);
    color: #fbbf24;
    border: 1px solid oklch(0.45 0.1 85 / 0.3);
  }

  /* Empty state */
  .blog-search-empty {
    text-align: center;
    padding: var(--space-8) 0;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .blog-search-bar {
      flex-direction: row;
    }
    .blog-article__title {
      font-size: 1.35rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('search-clear-btn') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('reset-search-btn') as HTMLButtonElement | null;
    const emptyState = document.getElementById('blog-search-empty');
    const emptyQueryText = document.getElementById('empty-query-text');
    const items = document.querySelectorAll<HTMLElement>('.blog-article-item');

    function applyFilter(query: string) {
      const q = query.trim().toLowerCase();
      let visibleCount = 0;

      items.forEach(item => {
        const title = item.dataset.title || '';
        const desc = item.dataset.desc || '';
        const tags = item.dataset.tags || '';

        const match = !q || title.includes(q) || desc.includes(q) || tags.includes(q);
        item.classList.toggle('hidden', !match);
        if (match) visibleCount++;
      });

      if (clearBtn) {
        clearBtn.style.display = q ? 'block' : 'none';
      }

      if (emptyState && emptyQueryText) {
        if (visibleCount === 0 && q) {
          emptyState.style.display = 'block';
          emptyQueryText.textContent = `"${query}"`;
        } else {
          emptyState.style.display = 'none';
        }
      }
    }

    input?.addEventListener('input', (e) => {
      applyFilter((e.target as HTMLInputElement).value);
    });

    clearBtn?.addEventListener('click', () => {
      if (input) {
        input.value = '';
        input.focus();
      }
      applyFilter('');
    });

    resetBtn?.addEventListener('click', () => {
      if (input) {
        input.value = '';
        input.focus();
      }
      applyFilter('');
    });

    // Handle Escape key to clear search
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.activeElement === input) {
        if (input) {
          input.value = '';
        }
        applyFilter('');
      }
    });
  });
</script>
