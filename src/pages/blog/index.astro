---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SiteAnalytics from '../../components/SiteAnalytics.astro';
import { getCollection } from 'astro:content';

const description = 'I share technical articles on AI engineering, agentic AI, LLMs, RAG systems, machine learning, computer vision, and software development.';

const base = import.meta.env.BASE_URL;

let posts: any[] = [];
try {
  const allPosts = await getCollection('blog');
  posts = allPosts
    .filter((p: any) => !p.data.draft)
    .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
} catch (e) {
  // No blog posts yet
}

// Build archive data: { "2025": { "November": 1, "October": 1 } }
const archive: Record<string, Record<string, number>> = {};
posts.forEach(post => {
  const d = post.data.pubDate;
  const year = d.getFullYear().toString();
  const month = d.toLocaleDateString('en-US', { month: 'long' });
  if (!archive[year]) archive[year] = {};
  archive[year][month] = (archive[year][month] || 0) + 1;
});

// Build unique tags with counts
const tagCounts: Record<string, number> = {};
posts.forEach(post => {
  post.data.tags?.forEach((tag: string) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <title>Blog | Md. Zahid Hasan — AI Engineer</title>
  <meta name="description" content={description} />
  <meta name="author" content="Md. Zahid Hasan" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:title" content="AI Engineering Blog — Md. Zahid Hasan" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@z4hiid" />
  <meta name="twitter:title" content="AI Engineering Blog — Md. Zahid Hasan" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="alternate" type="application/rss+xml" title="Md. Zahid Hasan Blog RSS" href={`${base}rss.xml`} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(base, Astro.site).href },
          { "@type": "ListItem", "position": 2, "name": "Blog", "item": new URL(`${base}blog`, Astro.site).href }
        ]
      },
      {
        "@type": "Blog",
        "name": "Md. Zahid Hasan — AI Engineering Blog",
        "description": description,
        "url": new URL(`${base}blog`, Astro.site).href,
        "author": { "@type": "Person", "name": "Md. Zahid Hasan", "url": new URL(base, Astro.site).href }
      }
    ]
  })} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Header />

  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <span class="section__label">Blog</span>
        <h1>Articles & Insights</h1>
        <p class="page-hero__desc">I share practical thoughts on AI engineering, machine learning, tools I build, books I read, and the occasional deep dive into research papers.</p>
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="container">
        {posts.length === 0 ? (
          <div class="empty-state">
            <i class="fa-solid fa-pen-nib empty-state__icon"></i>
            <h3>Coming soon</h3>
            <p>New articles on AI, machine learning, and tech are on the way. Stay tuned!</p>
          </div>
        ) : (
          <div class="blog-layout">
            <!-- Main content -->
            <div class="blog-main">
              <div class="blog-list" id="blog-list">
                {posts.map((post: any) => {
                  const slug = post.id.replace(/\.md$/, '');
                  const tags = post.data.tags || [];
                  return (
                    <a
                      href={`${base}blog/${slug}`}
                      class="blog-list-item"
                      data-tags={tags.join(',')}
                      data-year={post.data.pubDate.getFullYear()}
                      data-month={post.data.pubDate.toLocaleDateString('en-US', { month: 'long' })}
                    >
                      <div class="blog-list-item__content">
                        <div class="blog-list-item__meta">
                          <time datetime={post.data.pubDate.toISOString()}>
                            {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                          </time>
                        </div>
                        <h2 class="blog-list-item__title">{post.data.title}</h2>
                        <p class="blog-list-item__desc">{post.data.description}</p>
                        {tags.length > 0 && (
                          <div class="blog-list-item__tags">
                            {tags.map((tag: string) => (
                              <span class="tag">{tag}</span>
                            ))}
                          </div>
                        )}
                      </div>
                      <span class="blog-list-item__arrow"><i class="fa-solid fa-arrow-right"></i></span>
                    </a>
                  );
                })}
              </div>
              <div class="blog-empty-filter" id="blog-empty-filter" style="display:none;">
                <i class="fa-solid fa-filter-circle-xmark"></i>
                <p>No posts match this filter. <button id="clear-filter-btn" class="btn--ghost">Clear filter</button></p>
              </div>
            </div>

            <!-- Sidebar -->
            <aside class="blog-sidebar">
              <!-- Tags -->
              <div class="sidebar-card">
                <h3 class="sidebar-card__title"><i class="fa-solid fa-tags"></i> Topics</h3>
                <div class="sidebar-tags" id="sidebar-tags">
                  <button class="sidebar-tag sidebar-tag--active" data-tag="all">
                    All <span class="sidebar-tag__count">{posts.length}</span>
                  </button>
                  {sortedTags.map(([tag, count]) => (
                    <button class="sidebar-tag" data-tag={tag}>
                      {tag} <span class="sidebar-tag__count">{count}</span>
                    </button>
                  ))}
                </div>
              </div>

              <!-- Archive -->
              <div class="sidebar-card">
                <h3 class="sidebar-card__title"><i class="fa-solid fa-calendar-days"></i> Archive</h3>
                <div class="sidebar-archive" id="sidebar-archive">
                  {Object.entries(archive)
                    .sort(([a], [b]) => Number(b) - Number(a))
                    .map(([year, months]) => (
                      <div class="archive-year">
                        <button class="archive-year__toggle" data-year={year}>
                          <i class="fa-solid fa-chevron-down"></i>
                          <span>{year}</span>
                          <span class="archive-year__count">{Object.values(months).reduce((a, b) => a + b, 0)}</span>
                        </button>
                        <div class="archive-months">
                          {Object.entries(months).map(([month, count]) => (
                            <button class="archive-month" data-year={year} data-month={month}>
                              {month} <span class="sidebar-tag__count">{count}</span>
                            </button>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>

              <!-- RSS -->
              <a href={`${base}rss.xml`} class="sidebar-rss" target="_blank">
                <i class="fa-solid fa-rss"></i>
                <span>Subscribe via RSS</span>
              </a>
            </aside>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</body>
</html>

<style>
  .page-hero {
    padding-top: calc(72px + var(--space-4xl));
    padding-bottom: var(--space-3xl);
  }
  .page-hero h1 { margin-bottom: var(--space-md); }
  .page-hero__desc { max-width: 600px; font-size: 1.1rem; color: var(--text-secondary); }

  .empty-state { text-align: center; padding: var(--space-5xl) 0; }
  .empty-state__icon { font-size: 3rem; margin-bottom: var(--space-md); color: var(--accent); }
  .empty-state h3 { margin-bottom: var(--space-sm); }
  .empty-state p { color: var(--text-muted); max-width: 400px; margin: 0 auto; }

  /* Blog layout with sidebar */
  .blog-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-3xl);
    align-items: start;
  }

  /* Blog list */
  .blog-list { display: flex; flex-direction: column; gap: 0; }

  .blog-list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
    transition: all var(--duration-fast) var(--ease-out);
  }
  .blog-list-item:first-child { border-top: 1px solid var(--border-subtle); }
  .blog-list-item:hover { padding-left: var(--space-md); }
  .blog-list-item.hidden { display: none; }

  .blog-list-item__meta { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-bottom: var(--space-sm); }
  .blog-list-item__title { font-size: 1.3rem; margin-bottom: var(--space-sm); transition: color var(--duration-fast) var(--ease-out); }
  .blog-list-item:hover .blog-list-item__title { color: var(--accent); }
  .blog-list-item__desc { font-size: 0.9rem; color: var(--text-muted); margin-bottom: var(--space-sm); }
  .blog-list-item__tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .blog-list-item__arrow { font-size: 1rem; color: var(--text-muted); transition: all var(--duration-fast) var(--ease-out); flex-shrink: 0; margin-left: var(--space-xl); }
  .blog-list-item:hover .blog-list-item__arrow { color: var(--accent); transform: translateX(4px); }

  .blog-empty-filter {
    text-align: center;
    padding: var(--space-3xl) 0;
    color: var(--text-muted);
  }
  .blog-empty-filter i { font-size: 2rem; margin-bottom: var(--space-md); display: block; }

  /* Sidebar */
  .blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: sticky;
    top: 90px;
  }

  .sidebar-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .sidebar-card__title {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .sidebar-card__title i { color: var(--accent); font-size: 0.8rem; }

  /* Tag buttons */
  .sidebar-tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }

  .sidebar-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sidebar-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sidebar-tag--active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .sidebar-tag--active:hover {
    background: var(--accent-light);
    color: #fff;
  }

  .sidebar-tag__count {
    font-size: 0.6rem;
    opacity: 0.7;
  }

  /* Archive */
  .archive-year { margin-bottom: var(--space-sm); }
  .archive-year:last-child { margin-bottom: 0; }

  .archive-year__toggle {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: var(--space-xs) 0;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .archive-year__toggle:hover { color: var(--accent); }
  .archive-year__toggle i { font-size: 0.6rem; color: var(--text-muted); transition: transform var(--duration-fast); }
  .archive-year__count { margin-left: auto; font-size: 0.7rem; color: var(--text-muted); font-weight: 400; }

  .archive-months { padding-left: var(--space-lg); }

  .archive-month {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: var(--space-2xs) 0;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .archive-month:hover { color: var(--accent); }
  .archive-month--active { color: var(--accent); font-weight: 600; }

  /* RSS link */
  .sidebar-rss {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-xl);
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }
  .sidebar-rss i { color: var(--accent); }
  .sidebar-rss:hover { border-color: var(--accent); color: var(--accent); }

  /* Mobile */
  @media (max-width: 768px) {
    .blog-layout { grid-template-columns: 1fr; gap: var(--space-2xl); }
    .blog-sidebar { position: static; order: -1; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll<HTMLElement>('.blog-list-item');
    const tagBtns = document.querySelectorAll<HTMLButtonElement>('.sidebar-tag');
    const monthBtns = document.querySelectorAll<HTMLButtonElement>('.archive-month');
    const emptyFilter = document.getElementById('blog-empty-filter');
    const clearBtn = document.getElementById('clear-filter-btn');

    let activeTag = 'all';
    let activeYear = '';
    let activeMonth = '';

    function filterPosts() {
      let visibleCount = 0;
      items.forEach(item => {
        const postTags = item.dataset.tags?.split(',') || [];
        const postYear = item.dataset.year || '';
        const postMonth = item.dataset.month || '';

        let show = true;
        if (activeTag !== 'all' && !postTags.includes(activeTag)) show = false;
        if (activeYear && postYear !== activeYear) show = false;
        if (activeMonth && postMonth !== activeMonth) show = false;

        item.classList.toggle('hidden', !show);
        if (show) visibleCount++;
      });

      if (emptyFilter) {
        emptyFilter.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Tag filtering
    tagBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tagBtns.forEach(b => b.classList.remove('sidebar-tag--active'));
        btn.classList.add('sidebar-tag--active');
        activeTag = btn.dataset.tag || 'all';
        filterPosts();
      });
    });

    // Archive month filtering
    monthBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const clickedYear = btn.dataset.year || '';
        const clickedMonth = btn.dataset.month || '';

        // Toggle off if same
        if (activeYear === clickedYear && activeMonth === clickedMonth) {
          activeYear = '';
          activeMonth = '';
          monthBtns.forEach(b => b.classList.remove('archive-month--active'));
        } else {
          activeYear = clickedYear;
          activeMonth = clickedMonth;
          monthBtns.forEach(b => b.classList.remove('archive-month--active'));
          btn.classList.add('archive-month--active');
        }
        filterPosts();
      });
    });

    // Clear button
    clearBtn?.addEventListener('click', () => {
      activeTag = 'all';
      activeYear = '';
      activeMonth = '';
      tagBtns.forEach(b => b.classList.remove('sidebar-tag--active'));
      tagBtns[0]?.classList.add('sidebar-tag--active');
      monthBtns.forEach(b => b.classList.remove('archive-month--active'));
      filterPosts();
    });
  });
</script>
