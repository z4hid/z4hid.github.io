---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SiteAnalytics from '../../components/SiteAnalytics.astro';
import NonBlockingFontAwesome from '../../components/NonBlockingFontAwesome.astro';
import InteractiveBackground from '../../components/InteractiveBackground.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const description = 'Cybersecurity lab writeups: offensive red teaming, Active Directory compromise, Volatility memory forensics, and threat hunting by Md. Zahid Hasan.';

let writeups: any[] = [];
try {
  const allWriteups = await getCollection('writeups');
  writeups = allWriteups
    .filter((w: any) => !w.data.draft)
    .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
} catch (e) {
  writeups = [];
}

const getItemCategory = (w: any) => w.data.category || (w.id.toLowerCase().includes('offensive') ? 'offensive' : 'defensive');

const offensiveCount = writeups.filter((w: any) => getItemCategory(w) === 'offensive').length;
const defensiveCount = writeups.filter((w: any) => getItemCategory(w) === 'defensive').length;

function getDifficultyClass(difficulty?: string) {
  switch (difficulty?.toLowerCase()) {
    case 'easy':
      return 'diff-easy';
    case 'medium':
      return 'diff-medium';
    case 'hard':
      return 'diff-hard';
    case 'insane':
      return 'diff-insane';
    default:
      return 'diff-default';
  }
}

function getPostMeta(item: any) {
  const bodyText = item.body || '';
  const wordCount = bodyText.trim().split(/\s+/).filter(Boolean).length || 500;
  const formattedWords = wordCount >= 1000 ? `~${(wordCount / 1000).toFixed(1)}K words` : `~${wordCount} words`;
  const dateStr = item.data.pubDate.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }).toUpperCase();
  return { words: formattedWords, dateStr };
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <title>Cybersecurity Writeups & Labs | Md. Zahid Hasan</title>
  <meta name="description" content={description} />
  <meta name="author" content="Md. Zahid Hasan" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:title" content="Cybersecurity Writeups — Md. Zahid Hasan" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@z4hiid" />
  <meta name="twitter:title" content="Cybersecurity Writeups — Md. Zahid Hasan" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <NonBlockingFontAwesome />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(base, Astro.site).href },
          { "@type": "ListItem", "position": 2, "name": "Writeups", "item": new URL(`${base}writeups`, Astro.site).href }
        ]
      },
      {
        "@type": "CollectionPage",
        "name": "Cybersecurity Writeups & Labs by Md. Zahid Hasan",
        "description": description,
        "url": new URL(`${base}writeups`, Astro.site).href,
        "author": { "@type": "Person", "name": "Md. Zahid Hasan", "url": new URL(base, Astro.site).href }
      }
    ]
  })} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <InteractiveBackground />
  <Header />

  <main id="main-content" class="writeups-page">
    <div class="container">
      
      <!-- Page Hero Header -->
      <section class="page-hero">
        <div class="hero-tag-badge">
          <span class="pulse-dot"></span>
          <span>CYBERSECURITY LABS & AUDITS</span>
        </div>
        <h1 class="page-title">Cybersecurity Writeups</h1>
        <p class="page-desc">
          Documenting hands-on offensive security research and defensive digital forensics. Technical walkthroughs will be published here as I complete labs across both domains.
        </p>
      </section>

      <!-- 2 Standout Highlight Cards: Offensive & Defensive Tracks -->
      <section class="cyber-tracks-section" aria-label="Security Tracks">
        <div class="cyber-tracks-grid">
          
          <!-- Card 1: Offensive Security -->
          <div class="cyber-track-card cyber-track-card--offensive" id="card-offensive">
            <div class="track-card__glow-bg"></div>
            <div class="track-card__inner">
              <div class="track-card__top">
                <div class="track-icon-box offensive-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="22" y1="12" x2="18" y2="12"></line>
                    <line x1="6" y1="12" x2="2" y2="12"></line>
                    <line x1="12" y1="6" x2="12" y2="2"></line>
                    <line x1="12" y1="22" x2="12" y2="18"></line>
                  </svg>
                </div>
                <div class="track-card__meta">
                  <span class="track-badge track-badge--red">RED TEAM</span>
                  <span class="track-count">{offensiveCount} {offensiveCount === 1 ? 'Lab' : 'Labs'}</span>
                </div>
              </div>

              <h2 class="track-card__title">Offensive Security</h2>
              <p class="track-card__desc">
                Adversary simulation, vulnerability exploitation, Active Directory privilege escalation, Java deserialization, web RCE chains, and penetration testing labs.
              </p>

              <div class="track-card__tags">
                <span class="track-pill">Active Directory</span>
                <span class="track-pill">CVE Exploits</span>
                <span class="track-pill">Deserialization</span>
                <span class="track-pill">PrivEsc</span>
                <span class="track-pill">Web RCE</span>
              </div>

              <div class="track-status-box">
                <span class="status-indicator"></span>
                <span>{offensiveCount > 0 ? `${offensiveCount} writeup available` : 'Labs in progress · Writeups coming soon'}</span>
              </div>
            </div>
          </div>

          <!-- Card 2: Defensive Security -->
          <div class="cyber-track-card cyber-track-card--defensive" id="card-defensive">
            <div class="track-card__glow-bg"></div>
            <div class="track-card__inner">
              <div class="track-card__top">
                <div class="track-icon-box defensive-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="M9 12l2 2 4-4"></path>
                  </svg>
                </div>
                <div class="track-card__meta">
                  <span class="track-badge track-badge--blue">BLUE TEAM</span>
                  <span class="track-count">{defensiveCount} {defensiveCount === 1 ? 'Lab' : 'Labs'}</span>
                </div>
              </div>

              <h2 class="track-card__title">Defensive Security</h2>
              <p class="track-card__desc">
                Digital forensics, Volatility 3 volatile memory analysis, Wireshark PCAP triage, process injection detection, MITRE ATT&CK mapping, and malware triage.
              </p>

              <div class="track-card__tags">
                <span class="track-pill">Volatility 3</span>
                <span class="track-pill">Wireshark</span>
                <span class="track-pill">Memory Forensics</span>
                <span class="track-pill">MITRE ATT&CK</span>
                <span class="track-pill">Incident Triage</span>
              </div>

              <div class="track-status-box">
                <span class="status-indicator status-indicator--blue"></span>
                <span>{defensiveCount > 0 ? `${defensiveCount} writeup available` : 'Labs in progress · Writeups coming soon'}</span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Rough Hand-Drawn Divider -->
      <div class="rough-divider" aria-hidden="true"></div>

      <!-- Published Writeups Feed / Empty State -->
      {writeups.length > 0 ? (
        <section class="writeups-feed-section">
          <div class="section-header">
            <div>
              <span class="section-eyebrow">PUBLISHED LABS</span>
              <h2 class="section-title">Technical Walkthroughs</h2>
            </div>
          </div>

          <div class="writeups-grid" id="writeups-grid">
            {writeups.map((item: any) => {
              const slug = item.id.replace(/\.md$/, '');
              const meta = getPostMeta(item);
              const category = getItemCategory(item);
              const difficulty = item.data.difficulty || 'Medium';
              const diffClass = getDifficultyClass(difficulty);
              const tools = item.data.toolsUsed || [];

              return (
                <article class="writeup-item-card">
                  <div class="writeup-card__header">
                    <div class="writeup-card__badges">
                      <span class:list={['badge-category', category === 'offensive' ? 'badge-cat--red' : 'badge-cat--blue']}>
                        {category === 'offensive' ? 'OFFENSIVE' : 'DEFENSIVE'}
                      </span>
                      <span class:list={['badge-difficulty', diffClass]}>
                        {difficulty}
                      </span>
                    </div>
                    <span class="writeup-card__date">{meta.dateStr}</span>
                  </div>

                  <h3 class="writeup-card__title">
                    <a href={`${base}writeups/${slug}`}>{item.data.title}</a>
                  </h3>

                  <p class="writeup-card__desc">{item.data.description}</p>

                  {tools.length > 0 && (
                    <div class="writeup-card__tools">
                      {tools.slice(0, 4).map((tool: string) => (
                        <span class="tool-chip">{tool}</span>
                      ))}
                    </div>
                  )}

                  <div class="writeup-card__footer">
                    <span class="writeup-words">{meta.words}</span>
                    <a href={`${base}writeups/${slug}`} class="writeup-read-link">
                      <span>Read Walkthrough</span>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ) : (
        <section class="writeups-empty-feed">
          <div class="empty-state-card">
            <div class="empty-state-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <h3 class="empty-state-title">Labs & Research In Progress</h3>
            <p class="empty-state-desc">
              I am actively performing and documenting offensive penetration tests and defensive memory forensics labs. Detailed markdown walkthroughs with PoC steps, Wireshark packet analysis, and Volatility 3 triage will appear here.
            </p>
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  .writeups-page {
    position: relative;
    z-index: 1;
    padding-top: calc(64px + var(--space-6));
    padding-bottom: var(--space-8);
  }

  /* Hero Section */
  .page-hero {
    margin-bottom: var(--space-6);
  }

  .hero-tag-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    color: var(--text-faint);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 12px #ef4444; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.5vw, 3.8rem);
    font-weight: 550;
    line-height: 1.15;
    margin-bottom: var(--space-3);
    color: var(--text-strong);
  }

  .page-desc {
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 70ch;
    margin-bottom: var(--space-5);
  }

  /* Highlight Tracks Grid */
  .cyber-tracks-section {
    margin-bottom: var(--space-7);
  }

  .cyber-tracks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .cyber-track-card {
    position: relative;
    background: var(--bg-card);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    overflow: hidden;
    transition: transform var(--duration) var(--ease-out), background-color var(--duration) var(--ease-out);
  }

  .cyber-track-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--ink);
    border-radius: inherit;
    pointer-events: none;
    z-index: 2;
  }

  .track-card__inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .track-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .track-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-muted);
  }

  .offensive-icon {
    background: rgba(239, 68, 68, 0.12);
    color: #f87171;
    border-color: rgba(239, 68, 68, 0.3);
  }

  .defensive-icon {
    background: rgba(6, 182, 212, 0.12);
    color: #38bdf8;
    border-color: rgba(6, 182, 212, 0.3);
  }

  .track-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .track-badge {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .track-badge--red {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .track-badge--blue {
    background: rgba(6, 182, 212, 0.15);
    color: #7dd3fc;
    border: 1px solid rgba(6, 182, 212, 0.3);
  }

  .track-count {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .track-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 550;
    margin-bottom: var(--space-2);
    color: var(--text-strong);
  }

  .track-card__desc {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .track-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .track-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--bg-inset);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-pill);
    padding: 0.18rem 0.6rem;
  }

  .track-status-box {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-faint);
    background: var(--bg-inset);
    border: 1px solid var(--border-muted);
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    margin-top: auto;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #f87171;
  }

  .status-indicator--blue {
    background-color: #38bdf8;
  }

  /* Empty State Card */
  .writeups-empty-feed {
    padding: var(--space-4) 0;
  }

  .empty-state-card {
    background: var(--bg-card);
    border: 1px dashed var(--border-muted);
    border-radius: var(--radius-card);
    padding: var(--space-7) var(--space-6);
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }

  .empty-state-icon {
    color: var(--text-faint);
    margin-bottom: var(--space-3);
  }

  .empty-state-title {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 550;
    color: var(--text-strong);
    margin-bottom: var(--space-2);
  }

  .empty-state-desc {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* Writeups Grid Feed */
  .writeups-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .writeup-item-card {
    position: relative;
    background: var(--bg-card);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .writeup-item-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--ink);
    border-radius: inherit;
    pointer-events: none;
  }

  .writeup-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .writeup-card__badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .badge-category {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .badge-cat--red { background: rgba(239, 68, 68, 0.15); color: #fca5a5; }
  .badge-cat--blue { background: rgba(6, 182, 212, 0.15); color: #7dd3fc; }

  .badge-difficulty {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .diff-easy { background: rgba(34, 197, 94, 0.15); color: #86efac; }
  .diff-medium { background: rgba(234, 179, 8, 0.15); color: #fde047; }
  .diff-hard { background: rgba(249, 115, 22, 0.15); color: #fdba74; }
  .diff-insane { background: rgba(239, 68, 68, 0.2); color: #f87171; }
  .diff-default { background: rgba(255, 255, 255, 0.1); color: var(--text-muted); }

  .writeup-card__date {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .writeup-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }

  .writeup-card__title a {
    color: var(--text-strong);
    text-decoration: none;
  }

  .writeup-card__desc {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }

  .writeup-card__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tool-chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    background: var(--bg-inset);
    border: 1px solid var(--border-muted);
    border-radius: 4px;
    padding: 0.1rem 0.45rem;
  }

  .writeup-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-muted);
    margin-top: auto;
  }

  .writeup-words {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .writeup-read-link {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-strong);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 900px) {
    .cyber-tracks-grid {
      grid-template-columns: 1fr;
    }
    .writeups-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
