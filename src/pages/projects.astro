---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import NonBlockingFontAwesome from '../components/NonBlockingFontAwesome.astro';
import InteractiveBackground from '../components/InteractiveBackground.astro';
import { projects, categories } from '../data/projects';

const base = import.meta.env.BASE_URL;
const description = 'Portfolio of 17+ AI, machine learning, and cybersecurity systems engineered by Md. Zahid Hasan. Production LLMs, agents, and vision.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <title>Projects | Md. Zahid Hasan — AI Engineer</title>
  <meta name="description" content={description} />
  <meta name="author" content="Md. Zahid Hasan" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:title" content="AI Projects by Md. Zahid Hasan" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@z4hiid" />
  <meta name="twitter:title" content="AI Projects by Md. Zahid Hasan" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <NonBlockingFontAwesome />

  <!-- JSON-LD: BreadcrumbList + CollectionPage + SoftwareSourceCode items -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(base, Astro.site).href },
          { "@type": "ListItem", "position": 2, "name": "Projects", "item": new URL(`${base}projects`, Astro.site).href }
        ]
      },
      {
        "@type": "CollectionPage",
        "name": "AI & ML Projects by Md. Zahid Hasan",
        "description": description,
        "url": new URL(`${base}projects`, Astro.site).href,
        "author": {
          "@type": "Person",
          "name": "Md. Zahid Hasan",
          "url": new URL(base, Astro.site).href
        },
        "mainEntity": {
          "@type": "ItemList",
          "numberOfItems": projects.length,
          "itemListElement": projects.map((p, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "item": {
              "@type": "SoftwareSourceCode",
              "name": p.title,
              "description": p.description,
              "codeRepository": p.github,
              "programmingLanguage": p.techStack.filter(t => ["Python", "Django", "JavaScript", "TypeScript"].includes(t)),
              "author": {
                "@type": "Person",
                "name": "Md. Zahid Hasan",
                "url": new URL(base, Astro.site).href
              },
              "about": p.category
            }
          }))
        }
      }
    ]
  })} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <InteractiveBackground />
  <Header />

  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <span class="section__label">Portfolio</span>
        <h1>Projects</h1>
        <p class="page-hero__desc">This is my portfolio of AI, machine learning, and web development work, from agentic workflows to production-ready computer vision systems.</p>
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="container">
        <!-- Filter Tabs -->
        <div class="filter-tabs" id="filter-tabs">
          {categories.map(cat => (
            <button class:list={['filter-tab', { 'filter-tab--active': cat === 'All' }]} data-category={cat}>
              {cat}
            </button>
          ))}
        </div>

        <!-- Projects Grid -->
        <h2 class="sr-only">All Projects</h2>
        <div class="grid grid--3" id="projects-grid">
          {projects.map(project => (
            <a href={`${base}projects/${project.slug}`} class="card project-card" data-category={project.category}>
              <div class="project-card__header">
                <span class="project-card__category">{project.category}</span>
                <svg class="project-card__link-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              </div>
              <h3 class="project-card__title card-title-link">{project.title}</h3>
              <p class="project-card__desc">{project.description}</p>
              <div class="project-card__footer">
                <div class="project-card__tech">
                  {project.techStack.slice(0, 3).map(tech => (
                    <span class="tag">{tech}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</body>
</html>

<style>
  .page-hero {
    padding-top: calc(60px + var(--space-7));
    padding-bottom: var(--space-6);
  }

  .page-hero h1 {
    margin-bottom: var(--space-3);
  }

  .page-hero__desc {
    max-width: 58ch;
    font-size: var(--fs-lg);
    color: var(--text-muted);
    line-height: 1.65;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .filter-tab {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
    color: var(--text-muted);
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.375rem 0.875rem;
    cursor: pointer;
    transition: background-color var(--duration) var(--ease-out),
                color var(--duration) var(--ease-out);
  }

  .filter-tab::before {
    content: '';
    border-radius: inherit;
    border: 1px solid var(--ink-faint);
    pointer-events: none;
    position: absolute;
    inset: 0;
  }

  .filter-tab:hover {
    color: var(--text-strong);
    background: var(--btn-neutral-bg);
  }

  .filter-tab--active {
    color: var(--btn-filled-text);
    background: var(--btn-filled-bg);
  }

  .filter-tab--active::before { border-color: transparent; }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    transition: background-color var(--duration) var(--ease-out);
  }

  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--ink);
    border-radius: inherit;
    pointer-events: none;
  }

  .project-card:hover {
    background: var(--bg-card-hover);
  }

  .project-card.hidden { display: none; }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .project-card__category {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project-card__link-icon {
    color: var(--text-faint);
    transition: color var(--duration) var(--ease-out),
                transform var(--duration) var(--ease-out);
    flex-shrink: 0;
  }

  .project-card:hover .project-card__link-icon {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .project-card__title {
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    font-weight: 600;
    margin-bottom: var(--space-2);
    transition: color var(--duration) var(--ease-out);
  }

  .project-card:hover .project-card__title {
    color: var(--accent);
  }

  .project-card__desc {
    font-size: var(--fs-md);
    color: var(--text-muted);
    line-height: 1.6;
    flex-grow: 1;
    margin-bottom: var(--space-4);
  }

  .project-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: auto;
  }

  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
</style>

<script>
  const tabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll('.project-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('filter-tab--active'));
      tab.classList.add('filter-tab--active');
      const category = tab.getAttribute('data-category');
      cards.forEach(card => {
        const el = card as HTMLElement;
        if (category === 'All' || card.getAttribute('data-category') === category) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    });
  });
</script>
