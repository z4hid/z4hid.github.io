---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import NonBlockingFontAwesome from '../components/NonBlockingFontAwesome.astro';
import { projects, categories } from '../data/projects';

const base = import.meta.env.BASE_URL;
const description = 'Explore my AI and machine learning portfolio featuring 16+ projects: LLM chatbots, agentic workflows, RAG systems, computer vision apps, and full-stack AI tools.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <title>Projects | Md. Zahid Hasan — AI Engineer</title>
  <meta name="description" content={description} />
  <meta name="author" content="Md. Zahid Hasan" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:title" content="AI Projects by Md. Zahid Hasan" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@z4hiid" />
  <meta name="twitter:title" content="AI Projects by Md. Zahid Hasan" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <NonBlockingFontAwesome />

  <!-- JSON-LD: BreadcrumbList + CollectionPage + SoftwareSourceCode items -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(base, Astro.site).href },
          { "@type": "ListItem", "position": 2, "name": "Projects", "item": new URL(`${base}projects`, Astro.site).href }
        ]
      },
      {
        "@type": "CollectionPage",
        "name": "AI & ML Projects by Md. Zahid Hasan",
        "description": description,
        "url": new URL(`${base}projects`, Astro.site).href,
        "author": {
          "@type": "Person",
          "name": "Md. Zahid Hasan",
          "url": new URL(base, Astro.site).href
        },
        "mainEntity": {
          "@type": "ItemList",
          "numberOfItems": projects.length,
          "itemListElement": projects.map((p, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "item": {
              "@type": "SoftwareSourceCode",
              "name": p.title,
              "description": p.description,
              "codeRepository": p.github,
              "programmingLanguage": p.techStack.filter(t => ["Python", "Django", "JavaScript", "TypeScript"].includes(t)),
              "author": {
                "@type": "Person",
                "name": "Md. Zahid Hasan",
                "url": new URL(base, Astro.site).href
              },
              "about": p.category
            }
          }))
        }
      }
    ]
  })} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Header />

  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <span class="section__label">Portfolio</span>
        <h1>Projects</h1>
        <p class="page-hero__desc">This is my portfolio of AI, machine learning, and web development work, from agentic workflows to production-ready computer vision systems.</p>
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="container">
        <!-- Filter Tabs -->
        <div class="filter-tabs" id="filter-tabs">
          {categories.map(cat => (
            <button class:list={['filter-tab', { 'filter-tab--active': cat === 'All' }]} data-category={cat}>
              {cat}
            </button>
          ))}
        </div>

        <!-- Projects Grid -->
        <h2 class="sr-only">All Projects</h2>
        <div class="grid grid--3" id="projects-grid">
          {projects.map(project => (
            <a href={project.github} class="card project-card" data-category={project.category} target="_blank" rel="noopener noreferrer">
              <div class="project-card__header">
                <span class="project-card__category">{project.category}</span>
                <svg class="project-card__link-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </div>
              <h3 class="project-card__title">{project.title}</h3>
              <p class="project-card__desc">{project.description}</p>
              <div class="project-card__tech">
                {project.techStack.map(tech => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</body>
</html>

<style>

  .page-hero {
    padding-top: calc(72px + var(--space-4xl));
    padding-bottom: var(--space-3xl);
  }

  .page-hero h1 {
    margin-bottom: var(--space-md);
  }

  .page-hero__desc {
    max-width: 600px;
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
  }

  .filter-tab {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 0.5rem 1.2rem;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .filter-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-default);
  }

  .filter-tab--active {
    color: var(--bg-primary);
    background: var(--accent);
    border-color: var(--accent);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .project-card.hidden {
    display: none;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .project-card__category {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .project-card__link-icon {
    color: var(--text-muted);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .project-card:hover .project-card__link-icon {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .project-card__title {
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
  }

  .project-card__desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    flex-grow: 1;
    margin-bottom: var(--space-lg);
  }

  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
</style>

<script>
  const tabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll('.project-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('filter-tab--active'));
      tab.classList.add('filter-tab--active');
      const category = tab.getAttribute('data-category');
      cards.forEach(card => {
        const el = card as HTMLElement;
        if (category === 'All' || card.getAttribute('data-category') === category) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    });
  });
</script>
