---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import NonBlockingFontAwesome from '../components/NonBlockingFontAwesome.astro';
import { projects } from '../data/projects';
import { certificates } from '../data/certificates';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const description = 'AI Engineer building production chatbots, agentic workflows, RAG systems, and computer vision applications. 5+ AI chatbots shipped, 40% manual work reduction for teams, 16+ open-source projects.';

const featuredProjects = projects.filter(p => p.featured).slice(0, 6);

let blogPosts: any[] = [];
try {
  const allPosts = await getCollection('blog');
  blogPosts = allPosts
    .filter((p: any) => !p.data.draft)
    .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
} catch (e) {}

const base = import.meta.env.BASE_URL;

const skills = [
  {
    category: 'AI & Machine Learning',
    icon: `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 1 4 4c0 1.5-.8 2.8-2 3.5v1h3a3 3 0 0 1 3 3v1h1a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-3a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h1v-1a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v1h1a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h1v-1a3 3 0 0 1 3-3h3v-1a4 4 0 0 1-2-3.5A4 4 0 0 1 12 2z"/></svg>`,
    items: ['Large Language Models', 'Agentic AI', 'RAG Systems', 'Deep Learning', 'Computer Vision', 'NLP', 'Prompt Engineering'],
  },
  {
    category: 'Development',
    icon: `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/></svg>`,
    items: ['Python', 'Django', 'FastAPI', 'Flask', 'PostgreSQL', 'Docker', 'Git'],
  },
  {
    category: 'MLOps & Tools',
    icon: `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1.08 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.604.852.997 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1.08z"/></svg>`,
    items: ['DVC', 'MLflow', 'LangChain', 'Agno', 'OpenAI API', 'Google AI Studio', 'Linux'],
  },
];

const services = [
  {
    icon: `<svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/><circle cx="12" cy="16" r="1"/></svg>`,
    title: 'AI Chatbots & Agents',
    desc: 'Custom LLM-powered chatbots and agentic workflows that handle complex business tasks — reducing manual work by 40%.',
    stat: '5+ shipped',
  },
  {
    icon: `<svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
    title: 'Computer Vision',
    desc: 'Image classification, object detection, and visual AI for healthcare, security, and real-world applications.',
    stat: '3+ deployed',
  },
  {
    icon: `<svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    title: 'RAG & LLM Systems',
    desc: 'Retrieval-Augmented Generation pipelines that ground LLMs in your data — cutting hallucinations and boosting accuracy.',
    stat: '40% more accurate',
  },
  {
    icon: `<svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Full-Stack AI Apps',
    desc: 'End-to-end web applications with Django/FastAPI backends, integrated ML models, and production deployment.',
    stat: '16+ projects',
  },
];

const faqs = [
  { question: 'What AI services do you offer?', answer: 'I build custom AI chatbots, agentic workflows, RAG systems, computer vision applications, and full-stack AI-powered web apps. I specialize in taking projects from concept to production deployment.' },
  { question: 'What technologies do you work with?', answer: 'My primary stack includes Python, LangChain, Agno, OpenAI API, Google AI Studio, PyTorch, Django, FastAPI, and PostgreSQL. I also work with DVC, MLflow, and Docker for MLOps.' },
  { question: 'Can you build AI solutions for my business?', answer: 'Absolutely. I\'ve built 5+ production AI chatbots and agentic workflows that reduced manual work by 40%. I can evaluate your use case and build a tailored solution.' },
  { question: 'What is your experience with LLMs and Agentic AI?', answer: 'I have hands-on experience building agentic AI systems using LangChain and Agno. I hold certifications from DeepLearning.AI, HuggingFace, and Kaggle. My projects include multi-modal agents, prompt optimization tools, and email automation agents.' },
  { question: 'How can I contact you for a project?', answer: 'You can reach me through the contact form on this website, or email me at zahidhasan9297@gmail.com. I\'m also on LinkedIn and GitHub.' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <meta name="generator" content={Astro.generator} />
  <title>Md. Zahid Hasan — AI Engineer | LLMs, Agentic AI, Computer Vision</title>
  <meta name="description" content={description} />
  <meta name="author" content="Md. Zahid Hasan" />
  <meta name="keywords" content="AI Engineer, Machine Learning Engineer, LLM Developer, Agentic AI, RAG Systems, Computer Vision, Python Developer, Bangladesh" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:title" content="Md. Zahid Hasan — AI Engineer" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <meta property="og:site_name" content="Md. Zahid Hasan" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@z4hiid" />
  <meta name="twitter:title" content="Md. Zahid Hasan — AI Engineer" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="sitemap" href={`${base}sitemap.xml`} />
  <link rel="alternate" type="application/rss+xml" title="Blog RSS" href={`${base}rss.xml`} />
  <NonBlockingFontAwesome />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": "Md. Zahid Hasan — AI Engineer",
        "url": new URL(base, Astro.site).href,
        "description": description,
        "inLanguage": "en",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": new URL(base, Astro.site).href + "blog/?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Person",
        "name": "Md. Zahid Hasan",
        "givenName": "Zahid",
        "familyName": "Hasan",
        "jobTitle": "AI Engineer",
        "description": description,
        "url": new URL(base, Astro.site).href,
        "image": new URL(`${base}og-default.png`, Astro.site).href,
        "email": "zahidhasan9297@gmail.com",
        "worksFor": {
          "@type": "Organization",
          "name": "BrainSpark Digital",
          "url": "https://brainsparkd.com/"
        },
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "Uttara University",
          "url": "https://uttarauniversity.edu.bd/"
        },
        "knowsAbout": [
          "Artificial Intelligence", "Machine Learning", "Large Language Models",
          "Agentic AI", "RAG Systems", "Computer Vision", "Python",
          "Deep Learning", "Natural Language Processing", "MLOps"
        ],
        "knowsLanguage": ["en", "bn"],
        "nationality": { "@type": "Country", "name": "Bangladesh" },
        "sameAs": [
          "https://github.com/z4hid",
          "https://linkedin.com/in/z4hid",
          "https://twitter.com/z4hiid",
          "https://huggingface.co/z4hid",
          "https://kaggle.com/z4hid"
        ],
        "hasCredential": [
          { "@type": "EducationalOccupationalCredential", "name": "Agentic AI", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "DeepLearning.AI" }},
          { "@type": "EducationalOccupationalCredential", "name": "Fundamentals of Agents", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "Hugging Face" }},
          { "@type": "EducationalOccupationalCredential", "name": "Hugging Face Agents Course (Excellence)", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "Hugging Face" }},
          { "@type": "EducationalOccupationalCredential", "name": "5-Day Gen AI Intensive", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "Kaggle" }},
          { "@type": "EducationalOccupationalCredential", "name": "Convolutional Neural Networks in TensorFlow", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "DeepLearning.AI" }},
          { "@type": "EducationalOccupationalCredential", "name": "Introduction to TensorFlow for AI, ML, and Deep Learning", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "DeepLearning.AI" }}
        ],
        "hasOccupation": {
          "@type": "Occupation",
          "name": "AI Engineer",
          "occupationalCategory": "15-1252.00",
          "skills": "Large Language Models, Agentic AI, RAG Systems, Computer Vision, Python, Deep Learning"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map(faq => ({ "@type": "Question", "name": faq.question, "acceptedAnswer": { "@type": "Answer", "text": faq.answer }}))
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(base, Astro.site).href }
        ]
      }
    ]
  })} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Header />

  <main id="main-content">

    <!-- ===== HERO ===== -->
    <section class="hero" id="hero">
      <div class="hero__bg">
        <div class="hero__glow"></div>
        <div class="hero__glow hero__glow--2"></div>
        <div class="hero__grid-lines"></div>
        <div class="hero__particles">
          <span class="particle particle--1"></span>
          <span class="particle particle--2"></span>
          <span class="particle particle--3"></span>
          <span class="particle particle--4"></span>
          <span class="particle particle--5"></span>
        </div>
      </div>
      <div class="container hero__content">
        <div class="hero__text">
          <p class="hero__greeting animate-in">Hi, I'm</p>
          <h1 class="hero__name animate-in animate-delay-1">
            Zahid<br/><span class="hero__name-accent">Hasan</span>
          </h1>
          <div class="hero__title-badge animate-in animate-delay-2">
            <i class="fa-solid fa-microchip"></i>
            <span>AI Engineer</span>
          </div>
          <p class="hero__tagline animate-in animate-delay-3">
            I turn AI research into <strong>production systems that actually ship</strong>. LLM chatbots, agentic workflows, RAG pipelines, computer vision — built to solve real problems, not collect dust in a notebook.
          </p>
          <div class="hero__actions animate-in animate-delay-4">
            <a href={`${base}projects`} class="btn btn--primary">
              <i class="fa-solid fa-bolt"></i>
              See What I've Built
            </a>
            <a href={`${base}contact`} class="btn btn--outline"><i class="fa-solid fa-handshake"></i> Work With Me</a>
          </div>
        </div>
        <div class="hero__visual animate-in animate-delay-3">
          <div class="hero__orbit">
            <div class="hero__orbit-ring hero__orbit-ring--1"></div>
            <div class="hero__orbit-ring hero__orbit-ring--2"></div>
            <div class="hero__orbit-ring hero__orbit-ring--3"></div>
            <!-- Orbiting nodes with distinct colors -->
            <div class="hero__orbit-path hero__orbit-path--1">
              <div class="hero__orbit-node hero__orbit-node--ai" title="Artificial Intelligence">
                <i class="fa-solid fa-brain"></i>
              </div>
            </div>
            <div class="hero__orbit-path hero__orbit-path--2">
              <div class="hero__orbit-node hero__orbit-node--code" title="Code">
                <i class="fa-solid fa-code"></i>
              </div>
            </div>
            <div class="hero__orbit-path hero__orbit-path--3">
              <div class="hero__orbit-node hero__orbit-node--web" title="Web">
                <i class="fa-solid fa-globe"></i>
              </div>
            </div>
            <!-- Center AI brain icon -->
            <div class="hero__orbit-center">
              <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a4 4 0 0 1 4 4c0 1.5-.8 2.8-2 3.5v1h3a3 3 0 0 1 3 3v1h1a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-3a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h1v-1a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v1h1a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h1v-1a3 3 0 0 1 3-3h3v-1a4 4 0 0 1-2-3.5A4 4 0 0 1 12 2z"/></svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SOCIAL PROOF BAR ===== -->
    <section class="proof-bar">
      <div class="container">
        <div class="proof-bar__items">
          <div class="proof-bar__item animate-on-scroll">
            <span class="proof-bar__number">5+</span>
            <span class="proof-bar__label">AI Chatbots<br/>in Production</span>
          </div>
          <div class="proof-bar__divider"></div>
          <div class="proof-bar__item animate-on-scroll">
            <span class="proof-bar__number">40%</span>
            <span class="proof-bar__label">Manual Work<br/>Reduced</span>
          </div>
          <div class="proof-bar__divider"></div>
          <div class="proof-bar__item animate-on-scroll">
            <span class="proof-bar__number">16+</span>
            <span class="proof-bar__label">Open Source<br/>Projects</span>
          </div>
          <div class="proof-bar__divider"></div>
          <div class="proof-bar__item animate-on-scroll">
            <span class="proof-bar__number">2+</span>
            <span class="proof-bar__label">Years<br/>Experience</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section class="section" id="about">
      <div class="container">
        <span class="section__label">About</span>
        <h2 class="section__title">Building Intelligence,<br/>One System at a Time</h2>
        <div class="about__grid">
          <div class="about__content animate-on-scroll">
            <p><strong>I'm an AI Engineer</strong> at <a href="https://brainsparkd.com/" target="_blank" rel="noopener noreferrer">BrainSpark Digital</a> with 2+ years of hands-on experience shipping intelligent applications. My focus areas: Large Language Models, Agentic AI, RAG systems, and Computer Vision.</p>
            <p>The numbers tell the story: <strong>5+ production chatbots</strong> deployed, agentic workflows that <strong>cut manual work by 40%</strong>, and RAG systems that grounded LLM responses in real-time data — turning hallucinating models into reliable tools.</p>
            <p>I hold a <strong>B.Sc. in Computer Science</strong> from Uttara University (GPA 3.96/4.0) and certifications from DeepLearning.AI, Hugging Face, and Kaggle. Outside of work, I contribute to open-source, read research papers, and write about what I learn on <a href="/blog">this blog</a>.</p>
          </div>
          <div class="about__stats animate-on-scroll">
            <div class="stat-card">
              <div class="stat-card__icon"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a4 4 0 0 0-8 0v2"/></svg></div>
              <span class="stat-card__number">2+</span>
              <span class="stat-card__label">Years Experience</span>
            </div>
            <div class="stat-card">
              <div class="stat-card__icon"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
              <span class="stat-card__number">5+</span>
              <span class="stat-card__label">AI Chatbots Built</span>
            </div>
            <div class="stat-card">
              <div class="stat-card__icon"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></div>
              <span class="stat-card__number">40%</span>
              <span class="stat-card__label">Work Automated</span>
            </div>
            <div class="stat-card">
              <div class="stat-card__icon"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
              <span class="stat-card__number">16+</span>
              <span class="stat-card__label">Open Source Projects</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SERVICES ===== -->
    <section class="section section--alt" id="services">
      <div class="container">
        <span class="section__label">What I Do</span>
        <h2 class="section__title">Expertise That Delivers</h2>
        <p class="section__description">Every system I ship goes from prototype to production. No PowerPoint AI — just working software that handles real-world complexity.</p>
        <div class="grid grid--4 services-grid">
          {services.map((service, i) => (
            <div class="card service-card animate-on-scroll" style={`transition-delay: ${i * 0.1}s`}>
              <div class="service-card__icon" set:html={service.icon} />
              <span class="service-card__stat">{service.stat}</span>
              <h3 class="service-card__title">{service.title}</h3>
              <p class="service-card__desc">{service.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== SKILLS ===== -->
    <section class="section" id="skills">
      <div class="container">
        <span class="section__label">Tech Stack</span>
        <h2 class="section__title">Tools I Work With</h2>
        <div class="grid grid--3">
          {skills.map((skillGroup, i) => (
            <div class="card skill-group animate-on-scroll" style={`transition-delay: ${i * 0.1}s`}>
              <div class="skill-group__header">
                <div class="skill-group__icon" set:html={skillGroup.icon} />
                <h3 class="skill-group__title">{skillGroup.category}</h3>
              </div>
              <div class="skill-group__items">
                {skillGroup.items.map(item => (
                  <span class="tag">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== PROJECTS ===== -->
    <section class="section section--alt" id="projects">
      <div class="container">
        <div class="section__header-row">
          <div>
            <span class="section__label">Projects</span>
            <h2 class="section__title">Featured Work</h2>
          </div>
          <a href={`${base}projects`} class="btn btn--ghost">
            Explore All Projects
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="grid grid--3">
          {featuredProjects.map((project, i) => (
            <a href={project.github} class="card project-card animate-on-scroll" target="_blank" rel="noopener noreferrer" style={`transition-delay: ${i * 0.08}s`}>
              <div class="project-card__header">
                <span class="project-card__category">{project.category}</span>
                <svg aria-hidden="true" class="project-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              </div>
              <h3 class="project-card__title">{project.title}</h3>
              <p class="project-card__desc">{project.description}</p>
              <div class="project-card__tech">
                {project.techStack.slice(0, 3).map(tech => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== CERTIFICATES SLIDESHOW ===== -->
    <section class="section" id="certificates">
      <div class="container">
        <div class="section__header-row">
          <div>
            <span class="section__label">Credentials</span>
            <h2 class="section__title">Certified by Industry Leaders</h2>
