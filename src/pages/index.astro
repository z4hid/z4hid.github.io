---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import InteractiveBackground from '../components/InteractiveBackground.astro';
import { projects } from '../data/projects';
import { certificates } from '../data/certificates';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const description = 'AI Engineer & Cybersecurity Expert building production LLM chatbots, agentic workflows, offensive & defensive security systems.';

const featuredProjects = projects.filter(p => p.featured).slice(0, 6);

let blogPosts: any[] = [];
try {
  const allPosts = await getCollection('blog');
  blogPosts = allPosts
    .filter((p: any) => !p.data.draft)
    .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
} catch (e) {}

const base = import.meta.env.BASE_URL;

const skills = [
  {
    category: 'AI & Machine Learning',
    items: ['Large Language Models', 'Agentic AI', 'RAG Systems', 'Deep Learning', 'Computer Vision', 'DSPy', 'NLP', 'Prompt Optimization', 'LangChain', 'Agno'],
  },
  {
    category: 'Cybersecurity',
    items: ['Offensive Security', 'Defensive Security', 'Penetration Testing', 'Active Directory Exploitation', 'Memory Forensics', 'Volatility 3', 'Threat Hunting', 'Incident Response', 'Wireshark', 'Burp Suite'],
  },
  {
    category: 'Backend & Systems',
    items: ['Python', 'FastAPI', 'Django', 'Flask', 'PostgreSQL', 'Docker', 'Git', 'Linux'],
  },
  {
    category: 'MLOps & Tooling',
    items: ['DVC', 'MLflow', 'ChromaDB', 'FAISS', 'OpenAI API', 'Google AI Studio', 'PyTorch'],
  },
];

const services = [
  {
    icon: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/><circle cx="12" cy="16" r="1"/></svg>`,
    title: 'AI Chatbots & Agents',
    desc: 'Custom LLM-powered chatbots and autonomous multi-agent workflows that handle complex business tasks and eliminate manual operational toil.',
    stat: '5+ Shipped · 40% Work Reduction',
  },
  {
    icon: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M9 12l2 2 4-4"></path></svg>`,
    title: 'Offensive & Defensive Security',
    desc: 'Penetration testing, Active Directory exploitation, and red team audits combined with Volatility memory forensics, SIEM threat hunting, and incident triage.',
    stat: 'Red & Blue Team · Lab Audited',
  },
  {
    icon: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    title: 'RAG & Knowledge Systems',
    desc: 'Retrieval-Augmented Generation pipelines that ground models in your proprietary data — eliminating hallucinations and delivering reliable answers.',
    stat: 'Low Hallucination · Fast Retrieval',
  },
  {
    icon: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
    title: 'Computer Vision',
    desc: 'Deep learning vision pipelines for image classification, defect detection, and medical imaging from training to edge deployment.',
    stat: '3+ Deployed · High Accuracy',
  },
  {
    icon: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Full-Stack AI & Web Platforms',
    desc: 'Robust production architectures with FastAPI/Django backends, modern frontend experiences, Docker containers, and clean integrations.',
    stat: '17+ Projects · Production Ready',
  },
];

const faqs = [
  { question: 'What AI services do you offer?', answer: 'I build custom LLM chatbots, agentic workflows, RAG systems, computer vision models, and full-stack AI web applications. I specialize in taking AI systems from prototype to production deployment.' },
  { question: 'What technologies do you work with?', answer: 'My core stack includes Python, DSPy, LangChain, Agno, OpenAI API, Google AI Studio, PyTorch, FastAPI, Django, and PostgreSQL. For MLOps, I work with DVC, MLflow, and Docker.' },
  { question: 'Can you build AI solutions for my business?', answer: 'Yes. I have built 5+ production AI chatbots and automated workflows that reduced manual work by 40%. I can evaluate your workflow and engineer a high-reliability solution.' },
  { question: 'What is your experience with LLMs and Agentic AI?', answer: 'I have hands-on experience designing multi-agent workflows using LangChain, Agno, and DSPy. I also hold certifications from DeepLearning.AI, Hugging Face, and Kaggle.' },
  { question: 'How can I contact you for a project or consultation?', answer: 'You can reach out through the contact form on this website, or email me directly at zahidhasan9297@gmail.com. I respond within 24 hours.' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <meta name="generator" content={Astro.generator} />
  <title>Md. Zahid Hasan — AI & Cybersecurity Engineer</title>
  <meta name="description" content={description} />
  <meta name="author" content="Md. Zahid Hasan" />
  <meta name="keywords" content="AI Engineer, Cybersecurity Expert, Offensive Security, Defensive Security, Penetration Testing, Memory Forensics, Machine Learning Engineer, LLM Developer, Agentic AI, RAG Systems, Computer Vision, Python Developer, Bangladesh" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:title" content="Md. Zahid Hasan — AI & Cybersecurity Engineer" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <meta property="og:site_name" content="Md. Zahid Hasan" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@z4hiid" />
  <meta name="twitter:title" content="Md. Zahid Hasan — AI & Cybersecurity Engineer" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="sitemap" href={`${base}sitemap.xml`} />
  <link rel="alternate" type="application/rss+xml" title="Blog RSS" href={`${base}rss.xml`} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": "Md. Zahid Hasan — AI & Cybersecurity Engineer",
        "url": new URL(base, Astro.site).href,
        "description": description,
        "inLanguage": "en"
      },
      {
        "@type": "Person",
        "name": "Md. Zahid Hasan",
        "givenName": "Zahid",
        "familyName": "Hasan",
        "jobTitle": "AI & Cybersecurity Engineer",
        "description": description,
        "url": new URL(base, Astro.site).href,
        "image": new URL(`${base}zahid-hasan.webp`, Astro.site).href,
        "email": "zahidhasan9297@gmail.com",
        "worksFor": {
          "@type": "Organization",
          "name": "BrainSpark Digital",
          "url": "https://brainsparkd.com/"
        },
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "Uttara University",
          "url": "https://uttarauniversity.edu.bd/"
        },
        "knowsAbout": [
          "Artificial Intelligence", "Machine Learning", "Large Language Models",
          "Agentic AI", "RAG Systems", "Computer Vision", "Python",
          "Deep Learning", "Natural Language Processing", "MLOps",
          "Cybersecurity", "Offensive Security", "Defensive Security",
          "Penetration Testing", "Memory Forensics", "Threat Hunting", "Incident Response"
        ],
        "knowsLanguage": ["en", "bn"],
        "nationality": { "@type": "Country", "name": "Bangladesh" },
        "sameAs": [
          "https://github.com/z4hid",
          "https://linkedin.com/in/z4hid",
          "https://twitter.com/z4hiid",
          "https://huggingface.co/z4hid",
          "https://kaggle.com/z4hid"
        ],
        "hasCredential": [
          { "@type": "EducationalOccupationalCredential", "name": "Agentic AI", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "DeepLearning.AI" }},
          { "@type": "EducationalOccupationalCredential", "name": "Fundamentals of Agents", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "Hugging Face" }},
          { "@type": "EducationalOccupationalCredential", "name": "Hugging Face Agents Course (Excellence)", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "Hugging Face" }},
          { "@type": "EducationalOccupationalCredential", "name": "5-Day Gen AI Intensive", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "Kaggle" }},
          { "@type": "EducationalOccupationalCredential", "name": "Convolutional Neural Networks in TensorFlow", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "DeepLearning.AI" }},
          { "@type": "EducationalOccupationalCredential", "name": "Introduction to TensorFlow for AI, ML, and Deep Learning", "credentialCategory": "certificate", "recognizedBy": { "@type": "Organization", "name": "DeepLearning.AI" }}
        ],
        "hasOccupation": {
          "@type": "Occupation",
          "name": "AI Engineer",
          "occupationalCategory": "15-1252.00",
          "skills": "Large Language Models, Agentic AI, RAG Systems, Computer Vision, Python, Deep Learning"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map(faq => ({ "@type": "Question", "name": faq.question, "acceptedAnswer": { "@type": "Answer", "text": faq.answer }}))
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(base, Astro.site).href }
        ]
      }
    ]
  })} />

  <style>
    .home-page {
      padding-top: calc(64px + var(--space-6));
      padding-bottom: var(--space-8);
    }

    /* ===== HERO SECTION ===== */
    .hero-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-bottom: var(--space-5);
      max-width: 960px;
      margin: 0 auto;
    }

    .hero-avatar-wrapper {
      margin-bottom: var(--space-3);
    }

    .hero-avatar-frame {
      position: relative;
      width: 96px;
      height: 96px;
      border-radius: 24px;
      padding: 3px;
      background: var(--bg-card);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .hero-avatar-frame::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid var(--ink);
      border-radius: inherit;
      pointer-events: none;
    }

    .hero-avatar-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 20px;
    }

    .hero-signature {
      font-family: 'Playfair Display Variable', Georgia, cursive, serif;
      font-style: italic;
      font-size: 1.65rem;
      color: var(--text-muted);
      letter-spacing: 0.02em;
      margin-bottom: var(--space-4);
    }

    .hero-headline {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5.5vw, 4.4rem);
      font-weight: 550;
      line-height: 1.12;
      letter-spacing: -0.02em;
      margin-bottom: var(--space-4);
      max-width: 26ch;
      color: var(--text-strong);
    }

    .hero-struck {
      text-decoration: line-through;
      color: var(--text-faint);
      font-style: normal;
      font-weight: 400;
      margin-right: 0.15em;
    }

    .hero-headline em {
      font-family: 'Playfair Display Variable', Georgia, serif;
      font-style: italic;
      font-weight: 550;
    }

    .hero-bio {
      font-size: var(--fs-lg);
      line-height: 1.7;
      color: var(--text-body);
      max-width: 68ch;
      margin: 0 auto var(--space-5);
    }

    .hero-bio strong {
      color: var(--text-strong);
      font-weight: 600;
    }

    /* Social Icons Row */
    .hero-socials {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      margin-bottom: var(--space-5);
      flex-wrap: wrap;
    }

    .social-icon-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      color: var(--text-muted);
      background: transparent;
      transition: color var(--duration) var(--ease-out), background-color var(--duration) var(--ease-out);
    }

    .social-icon-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 1.5px solid var(--ink-faint);
      pointer-events: none;
    }

    .social-icon-btn:hover {
      color: var(--text-strong);
      background: var(--btn-neutral-bg);
    }

    .hero-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-top: var(--space-2);
      margin-bottom: var(--space-3);
    }

    /* ===== STAT STRIP ===== */
    .stat-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
      padding: var(--space-5) 0;
      text-align: center;
    }

    .stat-strip__item {
      display: flex;
      flex-direction: column-reverse;
      gap: var(--space-1);
    }

    .stat-strip__value {
      font-family: var(--font-mono);
      font-size: clamp(1.8rem, 3.5vw, 2.5rem);
      font-weight: 600;
      color: var(--text-strong);
      line-height: 1;
      margin: 0;
    }

    .stat-strip__label {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--text-muted);
      letter-spacing: 0.04em;
    }

    /* ===== ABOUT SECTION ===== */
    .about-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: var(--space-7);
      align-items: start;
    }

    .about-text p {
      font-size: var(--fs-lg);
      line-height: 1.7;
      color: var(--text-body);
      margin-bottom: var(--space-4);
    }

    .about-text p strong {
      color: var(--text-strong);
    }

    .about-text a {
      color: var(--text-strong);
      text-decoration: underline;
      text-decoration-color: var(--ink);
      text-underline-offset: 3px;
    }

    .about-text a:hover {
      text-decoration-color: currentColor;
    }

    .about-stats-card {
      position: relative;
      background: var(--bg-card);
      border-radius: var(--radius-card);
      overflow: hidden;
    }

    .about-stats-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid var(--ink);
      border-radius: inherit;
      pointer-events: none;
    }

    .about-stat-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-5);
      border-bottom: 1px solid var(--border-muted);
    }
    .about-stat-row:last-child { border-bottom: none; }

    .about-stat-num {
      font-family: var(--font-mono);
      font-size: var(--fs-2xl);
      font-weight: 600;
      color: var(--text-strong);
    }

    .about-stat-lbl {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--text-muted);
      text-align: right;
    }

    /* ===== SERVICES GRID ===== */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: var(--space-5);
    }

    .service-card {
      position: relative;
      background: var(--bg-card);
      border-radius: var(--radius-card);
      padding: var(--space-5);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .service-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid var(--ink);
      border-radius: inherit;
      pointer-events: none;
    }

    .service-card__icon-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--space-1);
    }

    .service-card__icon {
      color: var(--text-strong);
      display: inline-flex;
    }

    .service-card__stat {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.05em;
      color: var(--text-faint);
      text-transform: uppercase;
    }

    .service-card__title {
      font-family: var(--font-display);
      font-size: var(--fs-xl);
      font-weight: 550;
      margin: 0;
    }

    .service-card__desc {
      font-size: var(--fs-sm);
      color: var(--text-muted);
      line-height: 1.6;
      margin: 0;
    }

    /* ===== TECH STACK ===== */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }

    .skill-group {
      position: relative;
      background: var(--bg-card);
      border-radius: var(--radius-card);
      padding: var(--space-5);
    }

    .skill-group::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid var(--ink);
      border-radius: inherit;
      pointer-events: none;
    }

    .skill-group__title {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-strong);
      margin-bottom: var(--space-3);
    }

    .skill-group__items {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .skill-tag {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-muted);
      background: var(--btn-neutral-bg);
      border-radius: var(--radius-pill);
      padding: 0.2rem 0.6rem;
      border: 1px solid var(--ink-faint);
    }

    /* ===== SECTION HEADINGS ===== */
    .section-block {
      padding: var(--space-2) 0;
    }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-4);
      margin-bottom: var(--space-5);
    }

    .section-eyebrow {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.1em;
      color: var(--text-faint);
      text-transform: uppercase;
      margin-bottom: var(--space-1);
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 550;
      margin: 0;
      letter-spacing: -0.015em;
    }

    .section-link {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      color: var(--text-muted);
      text-transform: uppercase;
      text-decoration: none;
      transition: color var(--duration) var(--ease-out);
      white-space: nowrap;
    }

    .section-link:hover {
      color: var(--text-strong);
    }

    /* ===== PROJECTS GRID ===== */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }

    .project-card {
      position: relative;
      background: var(--bg-card);
      border-radius: var(--radius-card);
      padding: var(--space-5);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      text-decoration: none;
      color: inherit;
      transition: background-color var(--duration) var(--ease-out);
    }

    .project-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid var(--ink);
      border-radius: inherit;
      pointer-events: none;
    }

    .project-card:hover {
      background: var(--bg-card-hover);
    }

    .project-card__top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-2);
    }

    .project-card__title {
      font-family: var(--font-mono);
      font-size: var(--fs-md);
      font-weight: 600;
      color: var(--text-strong);
      margin: 0;
    }

    .project-card__tag {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.06em;
      color: var(--text-faint);
      text-transform: uppercase;
    }

    .project-card__desc {
      font-size: var(--fs-sm);
      color: var(--text-muted);
      line-height: 1.6;
      margin: 0;
      flex-grow: 1;
    }

    .project-card__tech {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
      margin-top: var(--space-2);
    }

    .project-card__tech-tag {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--text-faint);
    }

    /* ===== CERTIFICATES SLIDESHOW ===== */
    .trust-badges {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex-wrap: wrap;
      margin-bottom: var(--space-5);
    }

    .trust-badge-label {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--text-faint);
      margin-right: var(--space-2);
    }

    .trust-badge-pill {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--text-muted);
      border: 1px solid var(--ink-faint);
      border-radius: var(--radius-pill);
      padding: 0.2rem 0.65rem;
    }

    .cert-slideshow {
      overflow: hidden;
      position: relative;
      margin: 0 calc(-1 * var(--space-4));
      padding: 0 var(--space-4);
    }

    .cert-slideshow::before,
    .cert-slideshow::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 48px;
      z-index: 2;
      pointer-events: none;
    }

    .cert-slideshow::before {
      left: 0;
      background: linear-gradient(90deg, var(--bg-canvas), transparent);
    }

    .cert-slideshow::after {
      right: 0;
      background: linear-gradient(-90deg, var(--bg-canvas), transparent);
    }

    .cert-slideshow__track {
      display: flex;
      gap: var(--space-4);
      animation: cert-scroll-left 40s linear infinite;
      width: max-content;
    }

    .cert-slideshow__track:hover { animation-play-state: paused; }

    @keyframes cert-scroll-left {
      0% { transform: translateX(0); }
      100% { transform: translateX(calc(-50% - (var(--space-4) / 2))); }
    }

    .cert-slide {
      position: relative;
      flex-shrink: 0;
      width: min(320px, 78vw);
      background: var(--bg-card);
      border-radius: var(--radius-card);
      overflow: hidden;
    }

    .cert-slide::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid var(--ink);
      border-radius: inherit;
      pointer-events: none;
      z-index: 1;
    }

    .cert-slide__img {
      aspect-ratio: 16 / 11;
      overflow: hidden;
      background: var(--bg-inset);
    }

    .cert-slide__img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cert-slide__info {
      padding: var(--space-3) var(--space-4);
      border-top: 1px solid var(--border-muted);
    }

    .cert-slide__title {
      font-size: var(--fs-sm);
      font-weight: 600;
      margin-bottom: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .cert-slide__issuer {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-muted);
      margin: 0;
    }

    /* ===== BLOG ROWS ===== */
    .blog-feed {
      display: flex;
      flex-direction: column;
    }

    .blog-feed-row {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: var(--space-4) 0;
      text-decoration: none;
      color: inherit;
      border-bottom: 1px solid var(--border-muted);
      transition: color var(--duration) var(--ease-out);
    }

    .blog-feed-row::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      border-bottom: 1px solid var(--ink-faint);
      pointer-events: none;
    }

    .blog-feed-row:last-child {
      border-bottom: none;
    }
    .blog-feed-row:last-child::after {
      display: none;
    }

    .blog-feed-row__date {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.05em;
      color: var(--text-faint);
    }

    .blog-feed-row__title {
      font-family: var(--font-display);
      font-size: var(--fs-xl);
      font-weight: 520;
      line-height: 1.35;
      color: var(--text-strong);
      transition: color var(--duration) var(--ease-out);
      margin: 0;
    }

    .blog-feed-row__desc {
      font-size: var(--fs-sm);
      color: var(--text-muted);
      line-height: 1.6;
      margin: 0;
    }

    .blog-feed-row:hover .blog-feed-row__title {
      color: var(--accent);
    }

    /* ===== FAQ ACCORDION ===== */
    .faq-list {
      display: flex;
      flex-direction: column;
    }

    .faq-item {
      border-bottom: 1px solid var(--border-muted);
    }
    .faq-item:first-child {
      border-top: 1px solid var(--border-muted);
    }

    .faq-item__question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-4) 0;
      font-family: var(--font-display);
      font-size: var(--fs-lg);
      font-weight: 550;
      color: var(--text-strong);
      cursor: pointer;
      list-style: none;
      transition: color var(--duration) var(--ease-out);
    }

    .faq-item__question::-webkit-details-marker { display: none; }

    .faq-item__chevron {
      color: var(--text-faint);
      transition: transform var(--duration) var(--ease-out);
      flex-shrink: 0;
    }

    .faq-item[open] .faq-item__chevron {
      transform: rotate(180deg);
      color: var(--text-strong);
    }

    .faq-item__question:hover { color: var(--text-muted); }

    .faq-item__answer {
      padding-bottom: var(--space-5);
    }

    .faq-item__answer p {
      font-size: var(--fs-md);
      color: var(--text-muted);
      line-height: 1.7;
      margin: 0;
      max-width: 62ch;
    }

    /* ===== CTA SECTION ===== */
    .cta-card {
      position: relative;
      background: var(--bg-card);
      border-radius: var(--radius-card);
      padding: var(--space-7) var(--space-5);
      text-align: center;
    }

    .cta-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid var(--ink);
      border-radius: inherit;
      pointer-events: none;
    }

    .cta-title {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 4.5vw, 2.5rem);
      font-weight: 550;
      margin-bottom: var(--space-3);
    }

    .cta-desc {
      font-size: var(--fs-lg);
      color: var(--text-muted);
      max-width: 50ch;
      margin: 0 auto var(--space-6);
      line-height: 1.6;
    }

    .cta-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-3);
      flex-wrap: wrap;
    }

    .faq-list {
      max-width: 880px;
      margin: 0 auto;
    }

    .cta-card {
      max-width: 880px;
      margin: 0 auto;
    }

    @media (max-width: 1080px) {
      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .about-grid {
        grid-template-columns: 1fr;
        gap: var(--space-5);
      }
    }

    @media (max-width: 768px) {
      .stat-strip {
        grid-template-columns: repeat(2, 1fr);
        row-gap: var(--space-5);
      }
      .about-grid {
        grid-template-columns: 1fr;
      }
      .services-grid {
        grid-template-columns: 1fr;
      }
      .skills-grid {
        grid-template-columns: 1fr;
      }
      .projects-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .stat-strip {
        grid-template-columns: 1fr;
        gap: var(--space-4);
      }
      .hero-actions {
        flex-direction: column;
        width: 100%;
      }
      .hero-actions .btn {
        width: 100%;
      }
    }
  </style>
</head>

