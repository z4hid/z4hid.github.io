---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import NonBlockingFontAwesome from '../components/NonBlockingFontAwesome.astro';
import { certificates } from '../data/certificates';
import { Image } from 'astro:assets';

const base = import.meta.env.BASE_URL;
const description = 'Browse my AI and machine learning certifications, including credentials from DeepLearning.AI, Hugging Face, Kaggle, and other trusted platforms.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <title>Certificates & Credentials | Md. Zahid Hasan — AI Engineer</title>
  <meta name="description" content={description} />
  <meta name="author" content="Md. Zahid Hasan" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:title" content="AI Certifications — Md. Zahid Hasan" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@z4hiid" />
  <meta name="twitter:title" content="AI Certifications — Md. Zahid Hasan" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <NonBlockingFontAwesome />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(base, Astro.site).href },
          { "@type": "ListItem", "position": 2, "name": "Certificates", "item": new URL(`${base}certificates`, Astro.site).href }
        ]
      },
      {
        "@type": "ProfilePage",
        "name": "Certificates & Credentials — Md. Zahid Hasan",
        "description": description,
        "url": new URL(`${base}certificates`, Astro.site).href,
        "mainEntity": {
          "@type": "Person",
          "name": "Md. Zahid Hasan",
          "url": new URL(base, Astro.site).href,
          "jobTitle": "AI Engineer",
          "hasCredential": certificates.map(cert => ({
            "@type": "EducationalOccupationalCredential",
            "name": cert.title,
            "credentialCategory": "certificate",
            "recognizedBy": {
              "@type": "Organization",
              "name": cert.issuer
            },
            ...(cert.verifyUrl ? { "url": cert.verifyUrl } : {}),
            "dateCreated": cert.date
          }))
        }
      }
    ]
  })} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Header />

  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <span class="section__label">Credentials</span>
        <h1>Certificates & Credentials</h1>
        <p class="page-hero__desc">These certifications reflect my continuous learning in AI, machine learning, and modern software engineering.</p>
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="cert-grid">
          {certificates.map(cert => (
            <div class="cert-full-card">
              <div class="cert-full-card__img-wrap" data-lightbox>
                <Image src={cert.image} alt={cert.alt || `${cert.title} certificate from ${cert.issuer}`} loading="lazy" />
                <div class="cert-full-card__overlay">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M14 10l6.1-6.1M9 21H3v-6M10 14l-6.1 6.1"/></svg>
                  <span>Click to enlarge</span>
                </div>
              </div>
              <div class="cert-full-card__info">
                <h2 class="cert-full-card__title">{cert.title}</h2>
                <p class="cert-full-card__issuer">{cert.issuer}</p>
                <p class="cert-full-card__date">{cert.date}</p>
                {cert.verifyUrl && (
                  <a href={cert.verifyUrl} class="btn btn--ghost" target="_blank" rel="noopener noreferrer" style="margin-top: 0.5rem; padding: 0.25rem 0;">
                    Verify →
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
      <button class="lightbox__close" aria-label="Close" id="lightbox-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <img class="lightbox__img" id="lightbox-img" alt="Certificate preview" />
    </div>
  </main>

  <Footer />
</body>
</html>

<style>

  .page-hero {
    padding-top: calc(72px + var(--space-4xl));
    padding-bottom: var(--space-3xl);
  }

  .page-hero h1 { margin-bottom: var(--space-md); }

  .page-hero__desc {
    max-width: 600px;
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2xl);
  }

  .cert-full-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .cert-full-card:hover {
    border-color: var(--border-default);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .cert-full-card__img-wrap {
    position: relative;
    aspect-ratio: 16/11;
    overflow: hidden;
    cursor: pointer;
    background: var(--bg-elevated);
  }

  .cert-full-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .cert-full-card:hover .cert-full-card__img-wrap img {
    transform: scale(1.03);
  }

  .cert-full-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    background: rgba(8, 8, 10, 0.7);
    color: var(--text-primary);
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .cert-full-card__img-wrap:hover .cert-full-card__overlay {
    opacity: 1;
  }

  .cert-full-card__info {
    padding: var(--space-xl);
  }

  .cert-full-card__title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .cert-full-card__issuer {
    font-size: 0.9rem;
    color: var(--accent);
    margin-bottom: var(--space-xs);
  }

  .cert-full-card__date {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(8, 8, 10, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl);
    opacity: 0;
    visibility: hidden;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .lightbox.active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-xl);
    right: var(--space-xl);
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: var(--space-sm);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .lightbox__close:hover { color: var(--accent); }

  .lightbox__img {
    max-width: 90%;
    max-height: 85vh;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 768px) {
    .cert-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');

  document.querySelectorAll('[data-lightbox]').forEach(wrap => {
    wrap.addEventListener('click', () => {
      const img = wrap.querySelector('img');
      if (img && lightboxImg && lightbox) {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const closeLightbox = () => {
    lightbox?.classList.remove('active');
    document.body.style.overflow = '';
  };

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
