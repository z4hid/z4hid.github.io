---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import NonBlockingFontAwesome from '../components/NonBlockingFontAwesome.astro';
import InteractiveBackground from '../components/InteractiveBackground.astro';

const base = import.meta.env.BASE_URL;
const description = 'Contact Md. Zahid Hasan for AI engineering, LLM chatbots, agentic workflows, and cybersecurity audits. Direct 24-hour response.';
const contactFormAccessKey = (import.meta.env.PUBLIC_WEB3FORMS_KEY || '').trim();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <title>Contact | Md. Zahid Hasan — AI & Security</title>
  <meta name="description" content={description} />
  <meta name="author" content="Md. Zahid Hasan" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:title" content="Contact Md. Zahid Hasan — AI & Security" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@z4hiid" />
  <meta name="twitter:title" content="Contact Md. Zahid Hasan — AI & Security" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(`${base}og-default.png`, Astro.site).href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <NonBlockingFontAwesome />

  <!-- JSON-LD: BreadcrumbList + ContactPage (AI-SEO) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(base, Astro.site).href },
          { "@type": "ListItem", "position": 2, "name": "Contact", "item": new URL(`${base}contact`, Astro.site).href }
        ]
      },
      {
        "@type": "ContactPage",
        "name": "Contact Md. Zahid Hasan",
        "description": description,
        "url": new URL(`${base}contact`, Astro.site).href
      }
    ]
  })} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <InteractiveBackground />
  <Header />

  <main id="main-content">
    <section class="contact-hero">
      <div class="container">
        <span class="section__label">Get in Touch</span>
        <h1>Let's Build Something <span class="text-accent">Intelligent</span></h1>
        <p class="contact-hero__desc">Have a project idea or just want to chat about AI? I'd love to hear from you.</p>
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="container">
        <!-- Trust indicators -->
        <div class="contact-trust">
          <div class="contact-trust__item">
            <i class="fa-solid fa-bolt contact-trust__icon"></i>
            <div>
              <strong>24h response</strong>
              <span>I reply fast</span>
            </div>
          </div>
          <div class="contact-trust__item">
            <i class="fa-solid fa-comments contact-trust__icon"></i>
            <div>
              <strong>Free consultation</strong>
              <span>No commitment</span>
            </div>
          </div>
          <div class="contact-trust__item">
            <i class="fa-solid fa-earth-americas contact-trust__icon"></i>
            <div>
              <strong>Available worldwide</strong>
              <span>Remote-friendly</span>
            </div>
          </div>
        </div>

        <div class="contact-layout">
          <!-- Form side -->
          <div class="contact-form-card">
            <h2 class="contact-form-card__title"><i class="fa-regular fa-paper-plane"></i> Send a Message</h2>
            <p class="contact-form-card__subtitle">Tell me about your project — I'll get back within 24 hours.</p>

            <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
              <input type="hidden" name="access_key" value={contactFormAccessKey} />
              <input type="hidden" name="subject" value="New Contact from Portfolio" />
              <input type="hidden" name="from_name" value="Portfolio Contact Form" />
              <label for="botcheck-field" class="sr-only">Leave empty if human</label>
              <input type="checkbox" id="botcheck-field" name="botcheck" aria-label="Spam bot check" style="display: none;" tabindex="-1" />

              <div class="form-row">
                <div class="form-group">
                  <label for="name" class="form-label"><i class="fa-regular fa-user"></i> Name</label>
                  <input type="text" id="name" name="name" class="form-input" placeholder="Zahid Hasan" autocomplete="name" enterkeyhint="next" required />
                </div>
                <div class="form-group">
                  <label for="email" class="form-label"><i class="fa-regular fa-envelope"></i> Email</label>
                  <input type="email" id="email" name="email" class="form-input" placeholder="you@company.com" autocomplete="email" enterkeyhint="next" required />
                </div>
              </div>

              <div class="form-group">
                <label for="subject" class="form-label"><i class="fa-regular fa-lightbulb"></i> What are you looking for?</label>
                <select id="subject" name="form_subject" class="form-input" required>
                  <option value="" disabled selected>Select a topic</option>
                  <option value="AI Chatbot / Agent Development">AI Chatbot / Agent Development</option>
                  <option value="Cybersecurity Audit / Red Team">Cybersecurity Audit / Red Team</option>
                  <option value="Defensive Security / Incident Response">Defensive Security / Incident Response</option>
                  <option value="RAG System / LLM Integration">RAG System / LLM Integration</option>
                  <option value="Computer Vision Project">Computer Vision Project</option>
                  <option value="Full-Stack AI Application">Full-Stack AI Application</option>
                  <option value="Consulting / Advisory">Consulting / Advisory</option>
                  <option value="Collaboration / Open Source">Collaboration / Open Source</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message" class="form-label"><i class="fa-regular fa-message"></i> Your message</label>
                <textarea id="message" name="message" class="form-textarea" placeholder="What problem are you trying to solve? What would success look like?" rows="5" enterkeyhint="send" required></textarea>
              </div>

              <button type="submit" class="btn btn--filled contact-submit" id="submit-btn">
                <i class="fa-solid fa-paper-plane"></i>
                Send Message
              </button>

              <p class="form-privacy"><i class="fa-solid fa-lock"></i> Your info stays private. No spam, ever.</p>

              <div id="form-status" class="form-status"></div>
            </form>
          </div>

          <!-- Info side -->
          <div class="contact-sidebar">
            <div class="contact-info-card">
              <div class="contact-info-card__icon contact-info-card__icon--email">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <h2 class="contact-info-card__title">Email</h2>
              <a href="mailto:zahidhasan9297@gmail.com" class="contact-info-card__link">zahidhasan9297@gmail.com</a>
              <p class="contact-info-card__note">I typically respond the same day.</p>
            </div>

            <div class="contact-info-card">
              <div class="contact-info-card__icon contact-info-card__icon--location">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <h2 class="contact-info-card__title">Location</h2>
              <p class="contact-info-card__text">Gazipur, Dhaka, Bangladesh</p>
              <p class="contact-info-card__note">Open to remote work globally.</p>
            </div>

            <div class="contact-info-card">
              <div class="contact-info-card__icon contact-info-card__icon--social">
                <i class="fa-solid fa-share-nodes"></i>
              </div>
              <h2 class="contact-info-card__title">Connect</h2>
              <div class="contact-socials">
                <a href="https://github.com/z4hid" target="_blank" rel="noopener noreferrer" class="contact-social" title="GitHub">
                  <i class="fa-brands fa-github"></i>
                </a>
                <a href="https://linkedin.com/in/z4hid" target="_blank" rel="noopener noreferrer" class="contact-social" title="LinkedIn">
                  <i class="fa-brands fa-linkedin-in"></i>
                </a>
                <a href="https://twitter.com/z4hiid" target="_blank" rel="noopener noreferrer" class="contact-social" title="X/Twitter">
                  <i class="fa-brands fa-x-twitter"></i>
                </a>
                <a href="https://huggingface.co/z4hid" target="_blank" rel="noopener noreferrer" class="contact-social" title="Hugging Face">
                  <i class="fa-solid fa-face-smile"></i>
                </a>
                <a href="https://kaggle.com/z4hid" target="_blank" rel="noopener noreferrer" class="contact-social" title="Kaggle">
                  <i class="fa-brands fa-kaggle"></i>
                </a>
              </div>
            </div>

            <a href={`${base}MD.-ZAHID-HASAN-CV.pdf`} target="_blank" rel="noopener" class="contact-cv-btn">
              <i class="fa-solid fa-file-arrow-down"></i>
              <div>
                <strong>Download CV</strong>
                <span>See the full picture</span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</body>
</html>

<style>
  .contact-hero {
    padding-top: calc(60px + var(--space-7));
    padding-bottom: var(--space-6);
  }

  .contact-hero h1 {
    margin-bottom: var(--space-3);
  }

  .contact-hero__desc {
    max-width: 52ch;
    font-size: var(--fs-lg);
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* Trust indicators */
  .contact-trust {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-muted);
    border-bottom: 1px solid var(--border-muted);
  }

  .contact-trust__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .contact-trust__icon {
    font-size: 1rem;
    color: var(--accent);
    width: 32px;
    text-align: center;
    flex-shrink: 0;
  }

  .contact-trust__item div {
    display: flex;
    flex-direction: column;
  }

  .contact-trust__item strong {
    color: var(--text-strong);
    font-size: var(--fs-md);
    font-weight: 550;
  }

  .contact-trust__item span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  /* Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  /* Form card */
  .contact-form-card {
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }

  .contact-form-card__title {
    font-size: var(--fs-2xl);
    margin-bottom: var(--space-1);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .contact-form-card__title i { color: var(--accent); }

  .contact-form-card__subtitle {
    color: var(--text-muted);
    font-size: var(--fs-md);
    margin-bottom: var(--space-5);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .form-label i {
    margin-right: 2px;
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .contact-submit {
    width: 100%;
    min-height: 2.75rem;
    font-size: var(--fs-md);
    margin-top: var(--space-2);
  }

  .form-privacy {
    text-align: center;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    margin-top: var(--space-3);
  }

  .form-privacy i {
    margin-right: 4px;
    opacity: 0.7;
  }

  .form-status { margin-top: var(--space-3); text-align: center; font-family: var(--font-mono); font-size: var(--fs-sm); }
  .form-status.success { color: var(--success); }
  .form-status.error { color: var(--danger); }

  /* Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-info-card {
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    transition: border-color var(--duration) var(--ease-out),
                background-color var(--duration) var(--ease-out);
  }

  .contact-info-card:hover {
    border-color: var(--border-strong);
    background: var(--bg-card-hover);
  }

  .contact-info-card__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
    background: var(--btn-neutral-bg);
    color: var(--accent);
  }

  .contact-info-card__title {
    font-size: var(--fs-lg);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .contact-info-card__link {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    word-break: break-all;
  }
  .contact-info-card__link:hover { color: var(--text-strong); }

  .contact-info-card__text {
    color: var(--text-body);
    font-size: var(--fs-md);
    margin-bottom: 0;
  }

  .contact-info-card__note {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    margin-top: var(--space-1);
  }

  /* Social icons */
  .contact-socials {
    display: flex;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .contact-social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-size: 0.95rem;
    transition: color var(--duration) var(--ease-out),
                background-color var(--duration) var(--ease-out);
  }

  .contact-social:hover {
    color: var(--text-strong);
    background: var(--btn-neutral-bg);
  }

  /* CV download button */
  .contact-cv-btn {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    transition: border-color var(--duration) var(--ease-out),
                background-color var(--duration) var(--ease-out);
  }

  .contact-cv-btn:hover {
    border-color: var(--border-strong);
    background: var(--bg-card-hover);
  }

  .contact-cv-btn i {
    font-size: 1.15rem;
    color: var(--accent);
  }

  .contact-cv-btn strong {
    display: block;
    color: var(--text-strong);
    font-size: var(--fs-md);
    font-weight: 550;
  }

  .contact-cv-btn span {
    display: block;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
    .contact-trust {
      gap: var(--space-4);
      flex-direction: column;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .contact-form-card { padding: var(--space-5); }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');
  const accessKeyInput = form?.querySelector('input[name="access_key"]') as HTMLInputElement | null;

  const setStatus = (type: 'success' | 'error', message: string) => {
    if (!statusEl) return;
    statusEl.className = `form-status ${type}`;
    statusEl.innerHTML = message;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !statusEl) return;

    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
    submitBtn.setAttribute('disabled', 'true');

    try {
      const formData = new FormData(form);
      const accessKey = accessKeyInput?.value?.trim() || '';
      if (accessKey) {
        formData.set('access_key', accessKey);
      }
      const res = await fetch(form.action, {
        method: 'POST',
        body: formData,
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.success) {
        throw new Error(data?.message || 'Submission failed');
      }

      setStatus('success', '<i class="fa-solid fa-circle-check"></i> Message sent! I\'ll reply within 24 hours.');
      form.reset();
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : 'Submission failed';
      const lowerMessage = errorMessage.toLowerCase();

      if (lowerMessage.includes('access key') || lowerMessage.includes('invalid key')) {
        setStatus(
          'error',
          '<i class="fa-solid fa-circle-xmark"></i> Contact form is not configured on this deployment yet. Please try again shortly.'
        );
      } else if (lowerMessage.includes('network') || lowerMessage.includes('failed to fetch')) {
        setStatus(
          'error',
          '<i class="fa-solid fa-circle-xmark"></i> Network error. Please try again in a moment.'
        );
      } else {
        setStatus(
          'error',
          '<i class="fa-solid fa-circle-xmark"></i> Something went wrong. Try emailing me directly.'
        );
      }

      console.error('Contact form submit error:', err);
    } finally {
      submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Send Message';
      submitBtn.removeAttribute('disabled');
    }
  });
</script>
