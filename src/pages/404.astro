---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SiteAnalytics />
  <title>404 — Page Not Found | Md. Zahid Hasan</title>
  <meta name="description" content="The page you're looking for doesn't exist. Return to Zahid Hasan's AI Engineer portfolio." />
  <meta property="og:title" content="404 — Page Not Found" />
  <meta property="og:description" content="The page you're looking for doesn't exist." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body>
  <Header />
  <main id="main-content" class="error-page">
    <div class="container">
      <div class="error-content">
        <span class="error-code">404</span>
        <h1>Lost in the neural network</h1>
        <p>The page you're looking for doesn't exist or has been moved.</p>
        <a href={`${base}`} class="btn btn--filled">Back to Home</a>
      </div>
    </div>
  </main>
  <Footer />
</body>
</html>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: 60px;
  }

  .error-content {
    max-width: 500px;
    padding: var(--space-6) 0;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: clamp(5rem, 15vw, 8rem);
    font-weight: 600;
    color: var(--text-strong);
    line-height: 1;
    opacity: 0.12;
    display: block;
    margin-bottom: var(--space-3);
  }

  .error-content h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: var(--space-3);
  }

  .error-content p {
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }
</style>
