---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <p class="footer__copyright">
        &copy; {currentYear} MD. ZAHID HASAN
      </p>

      <nav class="footer__nav" aria-label="Footer navigation">
        <a href={`${base}about`} class="footer__link">ABOUT</a>
        <a href={`${base}projects`} class="footer__link">PROJECTS</a>
        <a href={`${base}writeups`} class="footer__link">WRITEUPS</a>
        <a href={`${base}blog`} class="footer__link">BLOG</a>
        <a href={`${base}privacy`} class="footer__link">PRIVACY</a>
        <a href={`${base}rss.xml`} class="footer__link" target="_blank" rel="noopener">RSS</a>
        <a href="mailto:zahidhasan9297@gmail.com" class="footer__link">EMAIL</a>
        <a href="https://github.com/z4hid" class="footer__link" target="_blank" rel="noopener noreferrer">GITHUB</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: var(--space-6) 0 var(--space-7);
    margin-top: var(--space-8);
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    border-top: 1.5px solid var(--ink);
    pointer-events: none;
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer__copyright {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin: 0;
  }

  .footer__nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .footer__link {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--text-strong);
  }

  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .footer__nav {
      gap: var(--space-4);
    }
  }
</style>

