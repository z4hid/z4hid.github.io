---
const currentYear = new Date().getFullYear();

const base = import.meta.env.BASE_URL;

const socialLinks = [
  { href: 'https://github.com/z4hid', label: 'GitHub', icon: 'github' },
  { href: 'https://linkedin.com/in/z4hid', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'https://twitter.com/z4hiid', label: 'X / Twitter', icon: 'twitter' },
  { href: 'https://huggingface.co/z4hid', label: 'HuggingFace', icon: 'huggingface' },
  { href: 'https://kaggle.com/z4hid', label: 'Kaggle', icon: 'kaggle' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__brand">
        <a href={base} class="footer__logo">
          <span class="footer__logo-name">ZAHID</span>
          <span class="footer__logo-accent">HASAN</span>
        </a>
        <p class="footer__tagline">AI Engineer — Turning complex AI concepts into tools that solve real problems.</p>
      </div>

      <div class="footer__social">
        {socialLinks.map(link => (
          <a href={link.href} class="footer__social-link" target="_blank" rel="noopener noreferrer" aria-label={link.label} title={link.label}>
            {link.icon === 'github' && (
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            )}
            {link.icon === 'linkedin' && (
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            )}
            {link.icon === 'twitter' && (
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            )}
            {link.icon === 'huggingface' && (
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-1.5 7.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm3 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm-5.25 5.25h7.5s0 3.75-3.75 3.75-3.75-3.75-3.75-3.75z"/></svg>
            )}
            {link.icon === 'kaggle' && (
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.825 23.859c-.022.092-.117.141-.281.141h-3.139c-.187 0-.351-.082-.492-.248l-5.178-6.589-1.448 1.374v5.111c0 .235-.117.352-.351.352H5.505c-.236 0-.354-.117-.354-.352V.353c0-.233.118-.353.354-.353h2.431c.234 0 .351.12.351.353v14.343l6.203-6.272c.165-.165.33-.246.495-.246h3.239c.144 0 .236.06.281.18.046.149.034.238-.036.327l-6.555 6.344 6.836 8.507c.095.104.117.208.075.346z"/></svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {currentYear} Md. Zahid Hasan. All rights reserved.</p>
      <p class="footer__credit">Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-3xl) 0 var(--space-xl);
    margin-top: var(--space-5xl);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer__logo {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    display: flex;
    gap: 0.25rem;
    margin-bottom: var(--space-sm);
  }

  .footer__logo-name { color: var(--text-primary); }
  .footer__logo-accent { color: var(--accent); }

  .footer__tagline {
    font-size: 0.875rem;
    color: var(--text-muted);
    max-width: 360px;
    margin: 0;
  }

  .footer__social {
    display: flex;
    gap: var(--space-sm);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .footer__social-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-subtle);
    transform: translateY(-2px);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .footer__bottom p { margin: 0; color: var(--text-muted); }
  .footer__credit a { color: var(--accent); }

  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .footer__tagline { max-width: 100%; }
    .footer__bottom {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
